<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    {%- if page_title == blank -%}
      {{ shop.name }}
    {%- else -%}
      {{ page_title }} — {{ shop.name }}
    {%- endif -%}
  </title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}" />
  {%- endif -%}

  {{ content_for_header }}

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet" />

  {{ 'theme.css' | asset_url | stylesheet_tag }}
{% capture boostersnippet %}{% include "booster-apps-common" %}{% endcapture %}{% unless boostersnippet contains "Liquid error" %}{{ boostersnippet }}{% endunless %}
</head>
<body>

<div class="site-top">

  <!-- ANNOUNCEMENT BAR -->
  <div class="announcement-bar">
    <span>Free Shipping on Orders Over $150 AUD</span>
    <span class="divider">|</span>
    <span>Afterpay &amp; Zip Available</span>
  </div>

  <!-- HEADER -->
  <header class="site-header">
    <div class="header-inner">
      <!-- Hamburger (mobile only) -->
      <button class="hamburger" id="hamburger" aria-label="Open menu" onclick="openMobileNav()">
        <span></span><span></span><span></span>
      </button>

      <!-- Desktop nav -->
      <nav>
        <ul class="header-nav">
          <li>
            <a href="{{ routes.all_products_collection_url }}">Shop All</a>
          </li>
          <li>
            <a href="{{ routes.all_products_collection_url }}">Jewellery ▾</a>
            <div class="mega-menu">
              <div>
                <h4>Collections</h4>
                <ul>
                  <li><a href="/collections/earrings">Earrings</a></li>
                  <li><a href="/collections/necklaces">Necklaces</a></li>
                  <li><a href="/collections/rings">Rings</a></li>
                  <li><a href="/collections/bracelets">Bracelets &amp; Bangles</a></li>
                </ul>
              </div>
              <div>
                <h4>Speciality</h4>
                <ul>
                  <li><a href="/collections/moissanite">Moissanite</a></li>
                  <li><a href="/collections/evil-eye">Evil Eye</a></li>
                  <li><a href="/collections/lab-diamonds">Lab Diamonds</a></li>
                  <li><a href="/collections/best-sellers">Best Sellers</a></li>
                </ul>
              </div>
            </div>
          </li>
          <li><a href="/pages/services">Services</a></li>
          <li><a href="/pages/customs-gallery">Customs Gallery</a></li>
        </ul>
      </nav>

      <div class="logo">
        <a href="{{ routes.root_url }}">
          <img src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name }}" width="200" height="auto" />
        </a>
      </div>

      <div class="header-actions">
        <a href="{{ routes.search_url }}" class="header-search" onclick="openSearch(); return false;">Search</a>
        <a href="{{ routes.account_url }}" class="header-account">Account</a>
        <a href="{{ routes.cart_url }}" class="cart-icon" onclick="openCart(); return false;">
          Bag <span class="cart-count">{{ cart.item_count }}</span>
        </a>
      </div>
    </div>

    <!-- Mobile nav overlay + drawer -->
    <div class="mobile-nav-overlay" id="mobileNavOverlay" onclick="closeMobileNav()"></div>
    <div class="mobile-nav" id="mobileNav">
      <div class="mobile-nav-header">
        <img src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name }}" width="120" />
        <button class="mobile-nav-close" onclick="closeMobileNav()">✕</button>
      </div>
      <ul class="mobile-nav-links">
        <li><a href="{{ routes.all_products_collection_url }}">Shop All</a></li>
        <li>
          <button class="mobile-nav-toggle" onclick="toggleMobileSubmenu(this)">
            Jewellery <span class="toggle-icon">+</span>
          </button>
          <div class="mobile-nav-submenu mobile-nav-sub">
            <a href="/collections/earrings">Earrings</a>
            <a href="/collections/necklaces">Necklaces</a>
            <a href="/collections/rings">Rings</a>
            <a href="/collections/bracelets">Bracelets &amp; Bangles</a>
            <a href="/collections/moissanite">Moissanite</a>
            <a href="/collections/evil-eye">Evil Eye</a>
            <a href="/collections/lab-diamonds">Lab Diamonds</a>
            <a href="/collections/best-sellers">Best Sellers</a>
          </div>
        </li>
        <li><a href="/pages/services">Services</a></li>
        <li><a href="/pages/customs-gallery">Customs Gallery</a></li>
        <li><a href="/pages/about">About</a></li>
        <li><a href="/pages/contact">Contact</a></li>
      </ul>
      <div class="mobile-nav-bottom">
        <a href="{{ routes.search_url }}" onclick="closeMobileNav(); openSearch(); return false;">Search</a>
        <a href="{{ routes.account_url }}">Account</a>
        <a href="/pages/ring-sizer">Ring Sizer</a>
        <a href="/pages/4cs">The 4 C's</a>
      </div>
    </div>
  </header>

  <!-- Search overlay -->
  <div class="search-overlay" id="search-overlay" onclick="closeSearchOutside(event)">
    <div class="search-panel">
      <div class="search-box">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color:var(--mid-grey);flex-shrink:0"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="search-input" placeholder="Search jewellery, collections..." onkeydown="handleSearchKey(event)" oninput="doSearch(this.value)" />
        <button class="search-close" onclick="closeSearch()">✕</button>
      </div>
      <div class="search-results" id="search-results" style="display:none"></div>
    </div>
  </div>

</div><!-- /.site-top -->

<main>
  {{ content_for_layout }}
</main>

<!-- FOOTER -->
<footer class="site-footer">
  <div class="footer-grid">
    <div class="footer-brand">
      <img src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name }}" class="footer-logo" />
      <p>A jewellery brand founded on a strong maternal bond and a vision of providing excellent customer experiences while offering an extensive selection of alluring and modern jewellery.</p>
      <div class="footer-social">
        <a href="https://www.instagram.com/melianaejewellers/" aria-label="Instagram" target="_blank" rel="noopener">IG</a>
      </div>
    </div>
    <div class="footer-col">
      <h4>Shop</h4>
      <ul>
        <li><a href="{{ routes.all_products_collection_url }}">Shop All</a></li>
        <li><a href="/collections/earrings">Earrings</a></li>
        <li><a href="/collections/necklaces">Necklaces</a></li>
        <li><a href="/collections/rings">Rings</a></li>
        <li><a href="/collections/bracelets">Bracelets</a></li>
        <li><a href="/collections/bridal">Bridal</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h4>Support</h4>
      <ul>
        <li><a href="/pages/contact">Contact Us</a></li>
        <li><a href="/pages/faq">FAQs</a></li>
        <li><a href="/pages/ring-sizer">Ring Sizer</a></li>
        <li><a href="/pages/returns-exchanges">Returns &amp; Exchanges</a></li>
        <li><a href="/pages/shipping">Shipping Info</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h4>Company</h4>
      <ul>
        <li><a href="/pages/about">About Us</a></li>
        <li><a href="/pages/stores">Store Locations</a></li>
        <li><a href="/pages/privacy-policy">Privacy Policy</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
    <div class="footer-payments">
      <span class="payment-icon">VISA</span>
      <span class="payment-icon">MC</span>
      <span class="payment-icon">AMEX</span>
      <span class="payment-icon">PAYPAL</span>
      <span class="payment-icon">AFTERPAY</span>
      <span class="payment-icon">APPLEPAY</span>
    </div>
  </div>
</footer>

<!-- CART DRAWER -->
<div class="cart-overlay" id="cartOverlay" onclick="closeCart()"></div>
<div class="cart-drawer" id="cartDrawer">
  <div class="cart-drawer-header">
    <h3>Your Bag</h3>
    <button class="cart-drawer-close" onclick="closeCart()">✕</button>
  </div>
  <div class="cart-drawer-body" id="cartBody">
    <div class="cart-empty"><span>◇</span>Your bag is empty</div>
  </div>
  <div class="cart-drawer-footer" id="cartFooter" style="display:none">
    <div class="cart-subtotal">
      <span class="cart-subtotal-label">Subtotal</span>
      <span class="cart-subtotal-amount" id="cartSubtotal">{{ 0 | money }}</span>
    </div>
    <a href="{{ routes.cart_url }}" class="cart-checkout-btn">Checkout</a>
    <span class="cart-continue" onclick="closeCart()">Continue Shopping</span>
  </div>
</div>

{{ 'theme.js' | asset_url | script_tag }}

</body>
</html>
