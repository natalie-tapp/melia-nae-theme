<section class="categories">
  <div class="container">
    <div class="section-header">
      <p class="section-eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="section-title">{{ section.settings.title }}</h2>
    </div>
    <div class="category-grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link }}" class="category-tile" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | img_url: '600x' }}"
                 alt="{{ block.settings.label }}"
                 class="category-tile-bg"
                 loading="lazy" />
          {%- endif -%}
          <div class="category-tile-label">
            <span>{{ block.settings.label }}</span>
            {%- if block.settings.sublabel != blank -%}
              <small>{{ block.settings.sublabel }}</small>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category Tiles",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Browse by Category" },
    { "type": "text", "id": "title", "label": "Title", "default": "Shop Our Collections" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "label", "label": "Label", "default": "Earrings" },
        { "type": "text", "id": "sublabel", "label": "Sub-label", "default": "Studs, hoops & drops" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{
    "name": "Category Tiles",
    "blocks": [
      { "type": "tile", "settings": { "label": "Earrings", "sublabel": "Studs, hoops & drops" } },
      { "type": "tile", "settings": { "label": "Necklaces", "sublabel": "Pendants & chains" } },
      { "type": "tile", "settings": { "label": "Rings", "sublabel": "Including custom builder" } },
      { "type": "tile", "settings": { "label": "Bracelets", "sublabel": "Bangles & tennis" } },
      { "type": "tile", "settings": { "label": "Bridal", "sublabel": "For your special day" } }
    ]
  }]
}
{% endschema %}
