{%- assign handle = section.settings.instagram_handle | default: 'melianae' -%}
{%- assign heading = section.settings.heading | default: 'Follow Us on Instagram' -%}
{%- assign subtext = section.settings.subtext | default: 'Get a glimpse of our world — new arrivals, behind-the-scenes, and jewellery inspiration.' -%}

<section class="instagram-section">
  <div class="instagram-inner">

    <!-- Phone mockup -->
    <div class="insta-phone-wrap">
      <div class="insta-phone">
        <div class="insta-phone-notch"></div>
        <div class="insta-phone-screen">
          <!-- App bar -->
          <div class="insta-app-bar">
            <svg width="62" height="14" viewBox="0 0 62 14" fill="none" xmlns="http://www.w3.org/2000/svg">
              <text x="0" y="11" font-family="'Billabong','Dancing Script',cursive" font-size="13" fill="#1C1C1A">{{ handle }}</text>
            </svg>
            <div style="display:flex;gap:6px;align-items:center;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#1C1C1A" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#1C1C1A" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            </div>
          </div>
          <!-- Profile strip -->
          <div class="insta-profile-strip">
            <div class="insta-avatar">MN</div>
            <div class="insta-stats">
              <div class="insta-stat"><strong>{{ section.blocks.size }}</strong><span>posts</span></div>
              <div class="insta-stat"><strong>1.2k</strong><span>followers</span></div>
              <div class="insta-stat"><strong>248</strong><span>following</span></div>
            </div>
          </div>
          <!-- Image grid -->
          <div class="insta-grid">
            {%- for block in section.blocks -%}
              {%- if block.type == 'post' -%}
                <div class="insta-cell">
                  {%- if block.settings.image != blank -%}
                    <img src="{{ block.settings.image | img_url: '300x300', crop: 'center' }}"
                         alt="{{ block.settings.alt | default: 'Instagram post' }}"
                         loading="lazy" />
                  {%- else -%}
                    <div class="insta-cell-placeholder"></div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
            {%- if section.blocks.size == 0 -%}
              {%- for i in (1..9) -%}
                <div class="insta-cell"><div class="insta-cell-placeholder"></div></div>
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>
        <div class="insta-phone-home"></div>
      </div>
    </div>

    <!-- Text side -->
    <div class="insta-text">
      <p class="insta-eyebrow">Social</p>
      <h2>{{ heading }}</h2>
      <p class="insta-handle">@{{ handle }}</p>
      <p class="insta-sub">{{ subtext }}</p>
      <a href="https://www.instagram.com/{{ handle }}/" target="_blank" rel="noopener" class="insta-cta">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        Follow on Instagram
      </a>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Instagram Preview",
  "settings": [
    { "type": "text", "id": "instagram_handle", "label": "Instagram handle (without @)", "default": "melianae" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Follow Us on Instagram" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Get a glimpse of our world — new arrivals, behind-the-scenes, and jewellery inspiration." }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Instagram Post",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "alt", "label": "Alt text" }
      ]
    }
  ],
  "max_blocks": 9,
  "presets": [
    { "name": "Instagram Preview" }
  ]
}
{% endschema %}
