<section class="meet-enzo-section">
  <style>
    .meet-enzo-section {
      padding: 90px 40px;
      background: #f9f7f4;
    }
    .meet-enzo-inner {
      max-width: 1100px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 70px;
      align-items: center;
    }
    .meet-enzo-img img {
      width: 100%;
      border-radius: 4px;
      object-fit: cover;
      display: block;
    }
    .meet-enzo-text .eyebrow {
      font-size: 11px;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: #9a7c5c;
      margin-bottom: 18px;
    }
    .meet-enzo-text h2 {
      font-size: 38px;
      font-weight: 400;
      margin: 0 0 24px;
      line-height: 1.2;
    }
    .meet-enzo-text p {
      font-size: 16px;
      line-height: 1.85;
      color: #555;
      margin: 0;
    }
    @media (max-width: 768px) {
      .meet-enzo-inner {
        grid-template-columns: 1fr;
        gap: 36px;
      }
      .meet-enzo-section {
        padding: 60px 24px;
      }
      .meet-enzo-text h2 { font-size: 28px; }
    }
  </style>
  <div class="meet-enzo-inner">
    <div class="meet-enzo-img">
      <img src="{{ 'enzo.jpg' | asset_url }}" alt="Enzo — Melia Nae Jewellery" />
    </div>
    <div class="meet-enzo-text">
      <p class="eyebrow">Our Team</p>
      <h2>Meet Enzo.</h2>
      <p>The friendly face behind Melia Nae Jewellery and the one you'll often find in store with a big smile, ready to help you find something special. From choosing the perfect engagement ring to bringing your dream wedding bands to life, Enzo is always happy to guide you through every detail and make the experience feel personal.</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Meet Enzo",
  "settings": []
}
{% endschema %}
