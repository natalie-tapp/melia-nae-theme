<section class="newsletter">
  <div class="container">
    <div class="newsletter-inner">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
      {%- form 'customer', id: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter" />
        <div class="newsletter-form">
          <input type="email"
                 name="contact[email]"
                 class="newsletter-input"
                 placeholder="{{ section.settings.placeholder }}"
                 required />
          <button type="submit" class="newsletter-submit">{{ section.settings.button_label }}</button>
        </div>
        {%- if form.posted_successfully? -%}
          <p style="color: var(--gold); margin-top: 12px; font-size: 13px;">Thank you for subscribing!</p>
        {%- endif -%}
      {%- endform -%}
      <p class="newsletter-disclaimer">{{ section.settings.disclaimer }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the Melia Nae Family" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Sign up for exclusive offers, new arrivals, and jewellery inspiration. Get 10% off your first order." },
    { "type": "text", "id": "placeholder", "label": "Input Placeholder", "default": "Your email address" },
    { "type": "text", "id": "button_label", "label": "Button Label", "default": "Subscribe" },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer", "default": "By subscribing you agree to our privacy policy. Unsubscribe any time." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
