{%- comment -%}
  Product card snippet
  Params: product (required), filter_key (optional), metal_key (optional)
{%- endcomment -%}

{%- assign _fk = filter_key | default: '' -%}
{%- assign _mk = metal_key | default: '' -%}

<a href="{{ product.url }}" class="product-card"
  {% if _fk != '' %}data-type="{{ _fk }}"{% endif %}
  {% if _mk != '' %}data-metal="{{ _mk }}"{% endif %}>
  <div class="product-card-image">
    {%- if product.featured_image != blank -%}
      <img id="card-img-{{ product.id }}"
           src="{{ product.featured_image | img_url: '600x800' }}"
           alt="{{ product.featured_image.alt | default: product.title | escape }}"
           class="product-card-image-bg"
           loading="lazy"
           width="600"
           height="800" />
    {%- else -%}
      <div class="product-card-image-bg" style="background: var(--blush);"></div>
    {%- endif -%}
    <button class="product-wishlist"
      data-wishlist-id="{{ product.id }}"
      data-wishlist-handle="{{ product.handle }}"
      data-wishlist-title="{{ product.title | escape }}"
      data-wishlist-price="{{ product.price | money }}"
      data-wishlist-image="{{ product.featured_image | img_url: '400x400', crop: 'center' }}"
      aria-label="Add to wishlist"
      onclick="event.preventDefault(); event.stopPropagation();">♡</button>
    <div class="product-quick-add">Quick Add</div>
    {%- if product.available == false -%}
      <div class="product-badge">Sold Out</div>
    {%- elsif product.tags contains 'new' or product.tags contains 'New' -%}
      <div class="product-badge">New</div>
    {%- elsif product.tags contains 'best-seller' or product.tags contains 'bestseller' -%}
      <div class="product-badge">Best Seller</div>
    {%- elsif product.compare_at_price > product.price -%}
      <div class="product-badge sale">Sale</div>
    {%- endif -%}
  </div>
  <p class="product-card-brand">{{ shop.name }}</p>
  <h3 class="product-card-name">{{ product.title }}</h3>
  <p class="product-card-price">
    {%- if product.compare_at_price > product.price -%}
      <span class="price-original">{{ product.compare_at_price | money }}</span>
      <span class="price-sale">{{ product.price | money }}</span>
    {%- else -%}
      {{ product.price | money }}
    {%- endif -%}
  </p>

  {%- comment -%}Colour/metal swatches for variant image swap{%- endcomment -%}
  {%- assign _swatch_opt = nil -%}
  {%- for opt in product.options_with_values -%}
    {%- assign _oln = opt.name | downcase -%}
    {%- if _oln == 'colour' or _oln == 'color' or _oln == 'metal' or _oln == 'material' -%}
      {%- assign _swatch_opt = opt -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if _swatch_opt != nil and _swatch_opt.values.size > 1 -%}
    <div class="card-swatches" onclick="event.preventDefault(); event.stopPropagation();">
      {%- for val in _swatch_opt.values limit: 5 -%}
        <button class="card-swatch-btn{% if forloop.first %} active{% endif %}"
          data-pid="{{ product.id }}"
          data-opt-pos="{{ _swatch_opt.position }}"
          data-val="{{ val | escape }}"
          onclick="swapCardVariant(this)"
          title="{{ val }}">{{ val | truncate: 12, '' }}</button>
      {%- endfor -%}
      {%- if _swatch_opt.values.size > 5 -%}
        <span class="card-swatch-more">+{{ _swatch_opt.values.size | minus: 5 }}</span>
      {%- endif -%}
    </div>
    <script>
      (function(){
        window.__mnPD = window.__mnPD || {};
        window.__mnPD[{{ product.id }}] = {
          images: {{ product.images | json }},
          variants: {{ product.variants | json }}
        };
      })();
    </script>
  {%- endif -%}
</a>
