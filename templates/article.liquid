<style>
  .article-hero { background: var(--blush); padding: 72px 40px 56px; text-align: center; border-bottom: 1px solid var(--border); }
  .article-eyebrow { font-size: 11px; letter-spacing: 3px; text-transform: uppercase; color: var(--gold); font-weight: 500; margin-bottom: 16px; }
  .article-hero h1 { font-family: var(--font-serif); font-size: clamp(28px, 4vw, 52px); font-weight: 300; line-height: 1.2; max-width: 760px; margin: 0 auto 20px; }
  .article-meta { font-size: 12px; color: var(--mid-grey); letter-spacing: 1px; }

  .article-body { max-width: 740px; margin: 0 auto; padding: 64px 40px 80px; }
  .article-body h2 { font-family: var(--font-serif); font-size: clamp(22px, 2.5vw, 32px); font-weight: 400; margin: 48px 0 16px; line-height: 1.3; }
  .article-body h3 { font-family: var(--font-serif); font-size: clamp(18px, 2vw, 24px); font-weight: 400; margin: 36px 0 12px; color: var(--charcoal); }
  .article-body p { font-size: 15px; color: var(--mid-grey); line-height: 1.9; margin-bottom: 20px; }
  .article-body ul, .article-body ol { margin: 0 0 20px 24px; }
  .article-body li { font-size: 15px; color: var(--mid-grey); line-height: 1.9; margin-bottom: 8px; }
  .article-body strong { color: var(--charcoal); font-weight: 600; }
  .article-body a { color: var(--gold); border-bottom: 1px solid var(--gold); }
  .article-body hr { border: none; border-top: 1px solid var(--border); margin: 48px 0; }
  .article-body img { width: 100%; margin: 32px 0; }

  .article-tags { margin-top: 48px; padding-top: 32px; border-top: 1px solid var(--border); display: flex; flex-wrap: wrap; gap: 8px; }
  .article-tag { font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase; padding: 6px 14px; border: 1px solid var(--border); color: var(--mid-grey); }

  .article-back { text-align: center; padding: 0 40px 80px; }
  .article-back a { font-size: 11px; letter-spacing: 2px; text-transform: uppercase; border-bottom: 1px solid var(--charcoal); padding-bottom: 2px; }

  @media (max-width: 768px) {
    .article-hero { padding: 48px 20px 40px; }
    .article-body { padding: 40px 20px 60px; }
  }
</style>

<div class="article-hero">
  <div class="article-eyebrow">{{ blog.title }}</div>
  <h1>{{ article.title }}</h1>
  <div class="article-meta">
    {{ article.published_at | date: "%d %B %Y" }}
    {%- if article.author != blank %} &nbsp;·&nbsp; {{ article.author }}{%- endif %}
  </div>
</div>

<div class="article-body">
  {{ article.content }}

  {%- if article.tags.size > 0 -%}
    <div class="article-tags">
      {%- for tag in article.tags -%}
        <span class="article-tag">{{ tag }}</span>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

<div class="article-back">
  <a href="{{ blog.url }}">← Back to Journal</a>
</div>
