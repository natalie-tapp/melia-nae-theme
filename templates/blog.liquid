<style>
  .blog-hero { background: var(--blush); padding: 72px 40px 56px; text-align: center; border-bottom: 1px solid var(--border); }
  .blog-hero p { font-size: 11px; letter-spacing: 3px; text-transform: uppercase; color: var(--gold); font-weight: 500; margin-bottom: 16px; }
  .blog-hero h1 { font-family: var(--font-serif); font-size: clamp(32px, 4vw, 56px); font-weight: 300; line-height: 1.2; }
  .blog-hero h1 em { font-style: italic; }

  .blog-grid-wrap { max-width: 1100px; margin: 0 auto; padding: 64px 40px 80px; }
  .blog-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }

  .blog-card { display: flex; flex-direction: column; }
  .blog-card-img { aspect-ratio: 3/2; overflow: hidden; background: var(--blush); margin-bottom: 20px; }
  .blog-card-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .blog-card:hover .blog-card-img img { transform: scale(1.03); }
  .blog-card-tag { font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: var(--gold); font-weight: 500; margin-bottom: 10px; }
  .blog-card h2 { font-family: var(--font-serif); font-size: 22px; font-weight: 400; line-height: 1.3; margin-bottom: 12px; }
  .blog-card p { font-size: 13px; color: var(--mid-grey); line-height: 1.8; flex: 1; margin-bottom: 16px; }
  .blog-card-date { font-size: 11px; color: var(--light-grey); letter-spacing: 1px; margin-bottom: 16px; }
  .blog-card-link { font-size: 11px; letter-spacing: 2px; text-transform: uppercase; border-bottom: 1px solid var(--charcoal); padding-bottom: 2px; align-self: flex-start; }

  .blog-pagination { display: flex; justify-content: center; gap: 8px; padding: 0 40px 80px; }
  .blog-pagination a, .blog-pagination span { display: inline-block; padding: 10px 18px; border: 1px solid var(--border); font-size: 13px; }
  .blog-pagination span { background: var(--charcoal); color: var(--white); border-color: var(--charcoal); }

  @media (max-width: 900px) { .blog-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) {
    .blog-hero { padding: 48px 20px 40px; }
    .blog-grid-wrap { padding: 40px 20px 60px; }
    .blog-grid { grid-template-columns: 1fr; gap: 32px; }
  }
</style>

<div class="blog-hero">
  <p>Melia Nae</p>
  <h1>The <em>Journal</em></h1>
</div>

<div class="blog-grid-wrap">
  <div class="blog-grid">
    {%- for article in blog.articles -%}
      <article class="blog-card">
        {%- if article.image -%}
          <a href="{{ article.url }}" class="blog-card-img">
            <img src="{{ article.image | img_url: '600x400', crop: 'center' }}"
                 alt="{{ article.image.alt | default: article.title | escape }}" />
          </a>
        {%- else -%}
          <a href="{{ article.url }}" class="blog-card-img"></a>
        {%- endif -%}

        {%- if article.tags.size > 0 -%}
          <div class="blog-card-tag">{{ article.tags.first }}</div>
        {%- endif -%}

        <h2><a href="{{ article.url }}">{{ article.title }}</a></h2>
        <div class="blog-card-date">{{ article.published_at | date: "%d %B %Y" }}</div>

        {%- if article.excerpt != blank -%}
          <p>{{ article.excerpt | strip_html | truncate: 160 }}</p>
        {%- else -%}
          <p>{{ article.content | strip_html | truncate: 160 }}</p>
        {%- endif -%}

        <a href="{{ article.url }}" class="blog-card-link">Read More →</a>
      </article>
    {%- endfor -%}
  </div>
</div>

{%- if paginate.pages > 1 -%}
  <div class="blog-pagination">
    {%- if paginate.previous -%}
      <a href="{{ paginate.previous.url }}">← Previous</a>
    {%- endif -%}
    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}
        <a href="{{ part.url }}">{{ part.title }}</a>
      {%- else -%}
        <span>{{ part.title }}</span>
      {%- endif -%}
    {%- endfor -%}
    {%- if paginate.next -%}
      <a href="{{ paginate.next.url }}">Next →</a>
    {%- endif -%}
  </div>
{%- endif -%}
