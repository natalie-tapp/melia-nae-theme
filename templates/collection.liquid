<!-- COLLECTION HERO -->
<div class="collection-hero">
  <p>Melia Nae</p>
  <h1>{{ collection.title | replace: 'All', '<em>All</em>' }}</h1>
  <span id="product-count">{{ collection.products_count }} Products</span>
</div>

<!-- CATEGORY PILLS -->
<div class="category-pills">
  <div class="pills-inner">
    {%- assign handles = 'all,earrings,necklaces,rings,bracelets,pendants,moissanite,lab-diamonds' | split: ',' -%}
    {%- assign labels  = 'All,Earrings,Necklaces,Rings,Bracelets,Pendants,Moissanite,Lab Diamonds' | split: ',' -%}
    {%- assign icons   = '✦,◇,○,◎,∞,◈,◉,◆' | split: ',' -%}
    {%- for handle in handles -%}
      {%- assign col_handle = handle -%}
      {%- if handle == 'all' -%}{%- assign col_handle = 'all' -%}{%- endif -%}
      {%- assign is_active = '' -%}
      {%- if collection.handle == handle or (handle == 'all' and collection.handle == 'all') -%}
        {%- assign is_active = ' active' -%}
      {%- endif -%}
      <a href="/collections/{{ col_handle }}" class="pill{{ is_active }}">
        <div class="pill-img">{{ icons[forloop.index0] }}</div>
        {{ labels[forloop.index0] }}
      </a>
    {%- endfor -%}
  </div>
</div>

<!-- MAIN LAYOUT -->
<div class="collection-layout">

  <!-- FILTER SIDEBAR -->
  <aside class="filter-sidebar">
    <div class="filter-header">
      <h3>Filter</h3>
      {%- if current_tags -%}
        <a href="/collections/{{ collection.handle }}" class="filter-clear">Clear</a>
      {%- else -%}
        <span class="filter-clear" style="opacity:0.3;">Clear</span>
      {%- endif -%}
    </div>

    <div class="filter-group">
      <div class="filter-group-header"><h4>Metal</h4><span>−</span></div>
      {%- assign metal_tags = 'gold,silver' | split: ',' -%}
      {%- assign metal_labels = 'Gold,Silver' | split: ',' -%}
      {%- for tag in metal_tags -%}
        {%- assign is_active = false -%}
        {%- if current_tags contains tag -%}{%- assign is_active = true -%}{%- endif -%}
        <a href="{% if is_active %}/collections/{{ collection.handle }}{% else %}{{ collection.url }}/{{ tag }}{% endif %}"
           class="filter-option{% if is_active %} checked{% endif %}">
          <div class="filter-checkbox">{% if is_active %}✓{% endif %}</div>
          <label>{{ metal_labels[forloop.index0] }}</label>
        </a>
      {%- endfor -%}
    </div>

    <div class="filter-group">
      <div class="filter-group-header"><h4>Sort</h4><span>−</span></div>
      <select class="sort-select" style="width:100%;margin-top:8px;" onchange="location.href='?sort_by='+this.value">
        <option value="best-selling" {% if collection.sort_by == 'best-selling' %}selected{% endif %}>Best Selling</option>
        <option value="created-descending" {% if collection.sort_by == 'created-descending' %}selected{% endif %}>Newest First</option>
        <option value="price-ascending" {% if collection.sort_by == 'price-ascending' %}selected{% endif %}>Price: Low → High</option>
        <option value="price-descending" {% if collection.sort_by == 'price-descending' %}selected{% endif %}>Price: High → Low</option>
        <option value="title-ascending" {% if collection.sort_by == 'title-ascending' %}selected{% endif %}>A–Z</option>
      </select>
    </div>
  </aside>

  <!-- PRODUCTS AREA -->
  <div class="products-area">
    <div class="products-toolbar">
      <span class="products-count" id="visible-count">{{ collection.products_count }} products</span>
      <div class="products-sort">
        <label for="sort">Sort by</label>
        <select id="sort" class="sort-select" onchange="location.href='?sort_by='+this.value">
          <option value="best-selling" {% if collection.sort_by == 'best-selling' %}selected{% endif %}>Best Selling</option>
          <option value="created-descending" {% if collection.sort_by == 'created-descending' %}selected{% endif %}>Newest First</option>
          <option value="price-ascending" {% if collection.sort_by == 'price-ascending' %}selected{% endif %}>Price: Low to High</option>
          <option value="price-descending" {% if collection.sort_by == 'price-descending' %}selected{% endif %}>Price: High to Low</option>
          <option value="title-ascending" {% if collection.sort_by == 'title-ascending' %}selected{% endif %}>A–Z</option>
        </select>
        <div class="view-toggle">
          <div class="view-btn active" title="Grid">⊞</div>
          <div class="view-btn" title="List">☰</div>
        </div>
      </div>
    </div>

    <!-- Product Grid -->
    {%- paginate collection.products by 48 -%}
    <div class="collection-product-grid" id="product-grid">
      {%- for product in collection.products -%}
        {%- assign type_lower = product.type | downcase -%}
        {%- if type_lower contains 'permanent' -%}{%- continue -%}{%- endif -%}
        {%- if type_lower contains 'earring' -%}{%- assign filter_key = 'earrings' -%}
        {%- elsif type_lower contains 'necklace' -%}{%- assign filter_key = 'necklaces' -%}
        {%- elsif type_lower contains 'ring' -%}{%- assign filter_key = 'rings' -%}
        {%- elsif type_lower contains 'bracelet' -%}{%- assign filter_key = 'bracelets' -%}
        {%- elsif type_lower contains 'pendant' -%}{%- assign filter_key = 'pendants' -%}
        {%- elsif type_lower contains 'bangle' -%}{%- assign filter_key = 'bangles' -%}
        {%- else -%}{%- assign filter_key = 'other' -%}
        {%- endif -%}

        {%- assign title_lower = product.title | downcase -%}
        {%- assign tags_lower = product.tags | join: ',' | downcase -%}
        {%- if tags_lower contains 'moissanite' or title_lower contains 'moissanite' -%}{%- assign metal_key = 'moissanite' -%}
        {%- elsif tags_lower contains 'rose-gold' or tags_lower contains 'rose gold' or title_lower contains 'rose gold' or title_lower contains 'in rose' -%}{%- assign metal_key = 'rose-gold' -%}
        {%- elsif tags_lower contains 'silver' or tags_lower contains 'sterling' or title_lower contains 'silver' or title_lower contains 'sterling' -%}{%- assign metal_key = 'silver' -%}
        {%- elsif tags_lower contains 'gold' or title_lower contains 'gold' -%}{%- assign metal_key = 'gold' -%}
        {%- else -%}{%- assign metal_key = 'other' -%}
        {%- endif -%}
        <a href="{{ product.url }}" class="product-card" data-type="{{ filter_key }}" data-metal="{{ metal_key }}">
          <div class="product-card-image">
            {%- if product.featured_image -%}
              <img src="{{ product.featured_image | img_url: '600x800' }}"
                   alt="{{ product.featured_image.alt | default: product.title | escape }}"
                   class="product-card-image-bg"
                   loading="lazy" />
            {%- else -%}
              <div class="product-card-image-bg" style="background:var(--blush)"></div>
            {%- endif -%}
            <div class="product-wishlist">♡</div>
            <div class="product-quick-add">Quick Add</div>
            {%- if product.available == false -%}
              <div class="product-badge">Sold Out</div>
            {%- elsif product.tags contains 'new' -%}
              <div class="product-badge">New</div>
            {%- elsif product.compare_at_price > product.price -%}
              <div class="product-badge sale">Sale</div>
            {%- endif -%}
          </div>
          <p class="product-card-brand">{{ shop.name }}</p>
          <h3 class="product-card-name">{{ product.title }}</h3>
          <p class="product-card-price">
            {%- if product.compare_at_price > product.price -%}
              <span class="price-original">{{ product.compare_at_price | money }}</span>
              <span class="price-sale">{{ product.price | money }}</span>
            {%- else -%}
              {{ product.price | money }}
            {%- endif -%}
          </p>
        </a>
      {%- endfor -%}
    </div>

    <!-- Pagination -->
    {%- if paginate.pages > 1 -%}
    <div class="pagination">
      {%- if paginate.previous -%}
        <a href="{{ paginate.previous.url }}" class="page-btn prev-next">← Prev</a>
      {%- endif -%}
      {%- for part in paginate.parts -%}
        {%- if part.is_link -%}
          <a href="{{ part.url }}" class="page-btn">{{ part.title }}</a>
        {%- else -%}
          <span class="page-btn active">{{ part.title }}</span>
        {%- endif -%}
      {%- endfor -%}
      {%- if paginate.next -%}
        <a href="{{ paginate.next.url }}" class="page-btn prev-next">Next →</a>
      {%- endif -%}
    </div>
    {%- endif -%}
  </div>
    {%- endpaginate -%}
</div>

<script>
  // Category pill filtering
  document.querySelectorAll('.pill[data-filter]').forEach(pill => {
    pill.addEventListener('click', () => {
      document.querySelectorAll('.pill').forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      applyFilters();
    });
  });

</script>
