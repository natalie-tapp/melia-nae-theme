<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --cream: #FAF8F5; --blush: #F2EBE2; --gold: #9C8060; --charcoal: #1C1C1A;
      --mid-grey: #6B6B68; --light-grey: #A8A8A5; --border: #E0D9D0; --white: #FFFFFF;
      --font-serif: 'Cormorant Garamond', Georgia, serif;
      --font-sans: 'Jost', system-ui, sans-serif;
    }
    html { font-size: 16px; }
    body { background: var(--cream); color: var(--charcoal); font-family: var(--font-sans); font-weight: 300; line-height: 1.6; }
    a { text-decoration: none; color: inherit; }
    ul { list-style: none; }

    /* HEADER */
    .announcement-bar { background: var(--charcoal); color: var(--white); text-align: center; padding: 10px 20px; font-size: 12px; letter-spacing: 1.5px; text-transform: uppercase; display: flex; align-items: center; justify-content: center; gap: 40px; }
    .announcement-bar .divider { opacity: 0.3; }
    .site-top { position: sticky; top: 0; z-index: 100; }
    .site-header { background: var(--white); border-bottom: 1px solid var(--border); }
    .header-inner { max-width: 1440px; margin: 0 auto; padding: 0 40px; display: grid;
      grid-template-columns: 1fr auto 1fr; align-items: center; height: 100px; }
    .header-nav { display: flex; gap: 24px; align-items: center; }
    .header-nav a { font-size: 11px; letter-spacing: 0.7px; text-transform: uppercase; font-weight: 500; color: var(--charcoal); white-space: nowrap; transition: color 0.2s; }
    .header-nav a:hover { color: var(--gold); }
    .logo { text-align: center; }
    .logo a img { width: 240px; height: auto; display: block; }
    .header-actions { display: flex; gap: 20px; align-items: center; justify-content: flex-end; }
    .header-actions a { font-size: 12px; letter-spacing: 1.5px; text-transform: uppercase; font-weight: 500; transition: color 0.2s; }
    .header-actions a:hover { color: var(--gold); }
    .cart-count { background: var(--charcoal); color: white; border-radius: 50%; width: 18px; height: 18px; font-size: 10px; display: inline-flex; align-items: center; justify-content: center; margin-left: 4px; }

    /* PAGE HERO */
    .page-hero { background: var(--charcoal); padding: 72px 40px; text-align: center; position: relative; overflow: hidden; }
    .page-hero::before { content: '◇'; position: absolute; font-size: 400px; color: rgba(255,255,255,0.03); top: 50%;  transform: translate(-50%, -50%); font-family: var(--font-serif); pointer-events: none; }
    .page-hero p { font-size: 11px; letter-spacing: 4px; text-transform: uppercase; color: var(--gold); font-weight: 500; margin-bottom: 14px; position: relative; }
    .page-hero h1 { font-family: var(--font-serif); font-size: clamp(36px, 4.5vw, 64px); font-weight: 300; color: var(--white); line-height: 1.1; position: relative; }
    .page-hero h1 em { font-style: italic; }
    .page-hero .hero-sub { margin-top: 20px; font-size: 14px; color: rgba(255,255,255,0.5); max-width: 560px; margin-left: auto; margin-right: auto; line-height: 1.85; position: relative; }

    /* INTRO */
    .intro-strip { background: var(--blush); border-bottom: 1px solid var(--border); padding: 40px; text-align: center; }
    .intro-strip p { font-size: 14px; color: var(--mid-grey); max-width: 700px; margin: 0 auto; line-height: 1.95; }

    /* 4 Cs NAV */
    .cs-nav { display: grid; grid-template-columns: repeat(4, 1fr); border-bottom: 1px solid var(--border); }
    .cs-nav-item { padding: 28px 20px; text-align: center; border-right: 1px solid var(--border); cursor: pointer; transition: background 0.2s; }
    .cs-nav-item:last-child { border-right: none; }
    .cs-nav-item:hover, .cs-nav-item.active { background: var(--white); }
    .cs-nav-item .cs-num { font-family: var(--font-serif); font-size: 40px; font-weight: 300; color: var(--gold); line-height: 1; display: block; font-style: italic; }
    .cs-nav-item .cs-label { font-size: 11px; letter-spacing: 2px; text-transform: uppercase; font-weight: 500; margin-top: 6px; display: block; }

    /* C SECTIONS */
    .cs-section { max-width: 1200px; margin: 0 auto; padding: 72px 40px; display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start; border-bottom: 1px solid var(--border); }
    .cs-section:nth-child(even) { direction: rtl; }
    .cs-section:nth-child(even) > * { direction: ltr; }
    .cs-section:last-child { border-bottom: none; }
    .cs-content .cs-number { font-family: var(--font-serif); font-size: 80px; font-weight: 300; color: var(--blush); line-height: 1; margin-bottom: -16px; font-style: italic; }
    .cs-content .cs-eyebrow { font-size: 10px; letter-spacing: 3px; text-transform: uppercase; font-weight: 500; color: var(--gold); margin-bottom: 8px; }
    .cs-content h2 { font-family: var(--font-serif); font-size: clamp(32px, 3vw, 48px); font-weight: 300; margin-bottom: 8px; }
    .cs-content h2 em { font-style: italic; }
    .cs-content .cs-tagline { font-size: 13px; color: var(--light-grey); letter-spacing: 1px; margin-bottom: 24px; }
    .cs-content p { font-size: 14px; color: var(--mid-grey); line-height: 1.95; margin-bottom: 24px; }
    .cs-grades { background: var(--white); border: 1px solid var(--border); padding: 24px 28px; margin-bottom: 24px; }
    .cs-grades h4 { font-size: 10px; letter-spacing: 2px; text-transform: uppercase; font-weight: 500; color: var(--light-grey); margin-bottom: 16px; }
    .grade-row { display: flex; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--blush); }
    .grade-row:last-child { border-bottom: none; }
    .grade-badge { background: var(--charcoal); color: var(--white); font-size: 10px; font-weight: 600; letter-spacing: 1px; padding: 3px 8px; white-space: nowrap; min-width: 64px; text-align: center; }
    .grade-badge.gold { background: var(--gold); }
    .grade-badge.mid { background: var(--mid-grey); }
    .grade-badge.light { background: var(--light-grey); color: var(--charcoal); }
    .grade-row span { font-size: 13px; color: var(--mid-grey); }
    .pro-tip { background: var(--blush); border-left: 3px solid var(--gold); padding: 16px 20px; }
    .pro-tip strong { font-size: 10px; letter-spacing: 2px; text-transform: uppercase; font-weight: 600; color: var(--gold); display: block; margin-bottom: 6px; }
    .pro-tip p { font-size: 13px; color: var(--charcoal); margin: 0; line-height: 1.7; }
    .cs-visual { position: relative; }
    .cs-visual-block { background: var(--blush); border: 1px solid var(--border); height: 420px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px; }
    .cs-visual-block .diamond-icon { font-size: 80px; line-height: 1; }
    .cs-visual-block .diamond-label { font-family: var(--font-serif); font-size: 24px; font-weight: 300; font-style: italic; color: var(--mid-grey); }
    .sparkle-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; height: 420px; }
    .sparkle-cell { background: var(--white); border: 1px solid var(--border); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; padding: 16px; }
    .sparkle-cell .spark { font-size: 32px; }
    .sparkle-cell .spark-label { font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; font-weight: 500; color: var(--mid-grey); }
    .color-bar { height: 420px; display: flex; flex-direction: column; gap: 2px; }
    .color-row { flex: 1; display: flex; align-items: center; gap: 16px; padding: 0 24px; border: 1px solid var(--border); }
    .color-swatch { width: 40px; height: 40px; border-radius: 50%; flex-shrink: 0; }
    .color-row span { font-size: 12px; letter-spacing: 1px; color: var(--mid-grey); }
    .carat-visual { height: 420px; display: flex; align-items: flex-end; justify-content: space-around; background: var(--white); border: 1px solid var(--border); padding: 24px 24px 32px; gap: 12px; }
    .carat-stone { display: flex; flex-direction: column; align-items: center; gap: 8px; }
    .carat-diamond { background: linear-gradient(135deg, rgba(220,215,210,0.9), rgba(255,255,255,0.95), rgba(200,195,190,0.8)); border: 1px solid var(--border); clip-path: polygon(50% 0%, 100% 30%, 80% 100%, 20% 100%, 0% 30%); }
    .carat-stone span { font-size: 11px; letter-spacing: 1px; color: var(--mid-grey); }

    /* FINAL */
    .final-section { background: var(--charcoal); color: var(--white); padding: 72px 40px; text-align: center; }
    .final-section h2 { font-family: var(--font-serif); font-size: clamp(32px, 3.5vw, 52px); font-weight: 300; margin-bottom: 20px; }
    .final-section h2 em { font-style: italic; }
    .final-section p { font-size: 14px; color: rgba(255,255,255,0.55); max-width: 620px; margin: 0 auto 36px; line-height: 1.9; }
    .final-cta-wrap { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
    .btn-light { display: inline-block; padding: 14px 44px; border: 1px solid var(--white); color: var(--white); font-size: 11px; letter-spacing: 2px; text-transform: uppercase; font-weight: 500; transition: all 0.2s; }
    .btn-light:hover { background: var(--white); color: var(--charcoal); }
    .btn-gold { display: inline-block; padding: 14px 44px; background: var(--gold); color: var(--white); font-size: 11px; letter-spacing: 2px; text-transform: uppercase; font-weight: 500; transition: opacity 0.2s; }
    .btn-gold:hover { opacity: 0.85; }

    /* FOOTER */
    .site-footer { background: var(--charcoal); color: var(--white); padding: 48px 0 0; }
    .footer-grid { max-width: 1440px; margin: 0 auto; padding: 0 40px; display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 48px; }
    .footer-logo { width: 220px; height: auto; margin-bottom: 14px; filter: brightness(0) invert(1); opacity: 0.85; }
    .footer-brand p { font-size: 13px; color: rgba(255,255,255,0.5); line-height: 1.8; max-width: 280px; }
    .footer-col h4 { font-size: 10px; letter-spacing: 2.5px; text-transform: uppercase; font-weight: 500; color: rgba(255,255,255,0.5); margin-bottom: 18px; }
    .footer-col ul li { margin-bottom: 10px; }
    .footer-col ul li a { font-size: 13px; color: rgba(255,255,255,0.7); transition: color 0.2s; }
    .footer-col ul li a:hover { color: var(--white); }
    .footer-bottom { max-width: 1440px; margin: 40px auto 0; padding: 18px 40px; border-top: 1px solid rgba(255,255,255,0.1); display: flex; justify-content: space-between; align-items: center; }
    .footer-bottom p { font-size: 12px; color: rgba(255,255,255,0.4); }
    .payment-icon { background: rgba(255,255,255,0.1); border-radius: 3px; padding: 3px 7px; font-size: 10px; color: rgba(255,255,255,0.45); margin-left: 6px; }

    @media (max-width: 900px) {
      .cs-section { grid-template-columns: 1fr; direction: ltr !important; }
      .cs-section:nth-child(even) { direction: ltr; }
      .cs-nav { grid-template-columns: repeat(3, 1fr); }
      .cs-nav-item:nth-child(2) { border-right: none; }
      .footer-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 600px) {
      .header-nav { display: none; }
      .header-inner { padding: 0 20px; }
      .cs-section { padding: 48px 20px; }
      .sparkle-grid { height: 280px; }
      .cs-visual-block { height: 280px; }
      .color-bar { height: 280px; }
      .carat-visual { height: 280px; }
    }
  
    /* Mega Menu */
    .header-nav > li { position: relative; }
    .mega-menu {
      position: absolute; top: calc(100% + 1px);
      left: 0;
      left: 0; transform: none;
      background: var(--white); border: 1px solid var(--border); border-top: none;
      min-width: 680px; padding: 32px 40px; display: none;
      grid-template-columns: repeat(3, 1fr); gap: 32px; z-index: 200;
    }
    .header-nav > li:hover .mega-menu { display: grid; }
    .mega-menu h4 { font-family: var(--font-serif); font-size: 15px; font-weight: 500; letter-spacing: 1px; margin-bottom: 12px; color: var(--charcoal); }
    .mega-menu ul { list-style: none; }
    .mega-menu ul li a { font-size: 12px; color: var(--mid-grey); letter-spacing: 0.5px; padding: 4px 0; display: block; transition: color 0.2s; }
    .mega-menu ul li a:hover { color: var(--charcoal); }
  
    /* Search overlay */
    .search-overlay {
      display: none; position: fixed; inset: 0; z-index: 9999;
      background: rgba(28,28,26,0.5); align-items: flex-start; justify-content: center;
    }
    .search-overlay.open { display: flex; }
    .search-box {
      background: var(--white); width: 100%; max-width: 560px; margin-top: 60px;
      padding: 20px 28px; display: flex; gap: 12px; align-items: center;
      border-bottom: 1px solid var(--border);
    }
    .search-box input {
      flex: 1; border: none; outline: none; font-family: var(--font-sans);
      font-size: 14px; letter-spacing: 0.5px; color: var(--charcoal);
      background: transparent;
    }
    .search-box input::placeholder { color: var(--light-grey); }
    .search-close { background: none; border: none; cursor: pointer; font-size: 20px; color: var(--mid-grey); padding: 4px; }
    .search-close:hover { color: var(--charcoal); }

    @media (max-width: 1280px) {
      .header-inner { padding: 0 24px; }
      .header-nav { gap: 16px; }
    }
</style>

