<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --cream: #FAF8F5; --blush: #F2EBE2; --gold: #9C8060; --charcoal: #1C1C1A;
      --mid-grey: #6B6B68; --light-grey: #A8A8A5; --border: #E0D9D0; --white: #FFFFFF;
      --font-serif: 'Cormorant Garamond', Georgia, serif;
      --font-sans: 'Jost', system-ui, sans-serif;
    }
    html { font-size: 16px; }
    body { background: var(--cream); color: var(--charcoal); font-family: var(--font-sans); font-weight: 300; line-height: 1.6; }
    a { text-decoration: none; color: inherit; }
    ul { list-style: none; }

    /* ANNOUNCEMENT BAR */
    .announcement-bar { background: var(--charcoal); color: var(--white); text-align: center; padding: 10px 20px; font-size: 12px; letter-spacing: 1.5px; text-transform: uppercase; display: flex; align-items: center; justify-content: center; gap: 40px; }
    .announcement-bar .divider { opacity: 0.3; }
    .site-top { position: sticky; top: 0; z-index: 100; }
    .site-header { background: var(--white); border-bottom: 1px solid var(--border); }
    .header-inner { max-width: 1440px; margin: 0 auto; padding: 0 40px; display: grid;
      grid-template-columns: 1fr auto 1fr; align-items: center; height: 100px; }
    .header-nav { display: flex; gap: 24px; align-items: center; }
    .header-nav a { font-size: 11px; letter-spacing: 0.7px; text-transform: uppercase; font-weight: 500; color: var(--charcoal); white-space: nowrap; transition: color 0.2s; }
    .header-nav a:hover { color: var(--gold); }
    .logo { text-align: center; }
    .logo a img { width: 240px; height: auto; display: block; }
    .header-actions { display: flex; gap: 20px; align-items: center; justify-content: flex-end; }
    .header-actions a { font-size: 12px; letter-spacing: 1.5px; text-transform: uppercase; font-weight: 500; transition: color 0.2s; }
    .header-actions a:hover { color: var(--gold); }
    .cart-count { background: var(--charcoal); color: white; border-radius: 50%; width: 18px; height: 18px; font-size: 10px; display: inline-flex; align-items: center; justify-content: center; margin-left: 4px; }

    /* HERO */
    .about-hero { position: relative; height: 520px; overflow: hidden; display: flex; align-items: center; justify-content: center; text-align: center; }
    .about-hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center top; }
    .about-hero-overlay { position: absolute; inset: 0; background: rgba(28,28,26,0.45); }
    .about-hero-content { position: relative; z-index: 1; color: var(--white); padding: 0 40px; }
    .about-hero-content p { font-size: 11px; letter-spacing: 4px; text-transform: uppercase; font-weight: 500; color: rgba(255,255,255,0.7); margin-bottom: 14px; }
    .about-hero-content h1 { font-family: var(--font-serif); font-size: clamp(44px, 5vw, 72px); font-weight: 300; line-height: 1.1; }
    .about-hero-content h1 em { font-style: italic; }

    /* INTRO */
    .about-intro { max-width: 780px; margin: 0 auto; padding: 80px 40px 0; text-align: center; }
    .about-intro h2 { font-family: var(--font-serif); font-size: clamp(32px, 3.5vw, 48px); font-weight: 300; margin-bottom: 24px; }
    .about-intro h2 em { font-style: italic; }
    .about-intro p { font-size: 15px; color: var(--mid-grey); line-height: 2; }

    /* NAME MEANING */
    .name-meaning { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; margin: 64px 40px; max-width: 1200px; margin-left: auto; margin-right: auto; }
    .name-card { background: var(--white); border: 1px solid var(--border); padding: 48px 40px; text-align: center; }
    .name-card .name-arabic { font-family: var(--font-serif); font-size: 72px; font-weight: 300; color: var(--gold); line-height: 1; margin-bottom: 12px; font-style: italic; }
    .name-card h3 { font-family: var(--font-serif); font-size: 28px; font-weight: 400; margin-bottom: 10px; }
    .name-card p { font-size: 13px; color: var(--mid-grey); letter-spacing: 0.5px; }

    /* PROMISE */
    .about-promise { background: var(--blush); padding: 80px 40px; }
    .about-promise-inner { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
    .promise-text .eyebrow { font-size: 11px; letter-spacing: 3px; text-transform: uppercase; color: var(--gold); font-weight: 500; margin-bottom: 16px; }
    .promise-text h2 { font-family: var(--font-serif); font-size: clamp(32px, 3vw, 44px); font-weight: 300; margin-bottom: 28px; }
    .promise-text h2 em { font-style: italic; }
    .promise-text p { font-size: 14px; color: var(--mid-grey); line-height: 1.95; margin-bottom: 18px; }
    .promise-image { position: relative; }
    .promise-image img { width: 100%; height: 540px; object-fit: cover; display: block; }
    .promise-image-caption { position: absolute; bottom: -1px; left: 0; right: 0; background: var(--charcoal); color: var(--white); padding: 14px 20px; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; text-align: center; font-weight: 500; }

    /* VALUES */
    .about-values { max-width: 1200px; margin: 80px auto; padding: 0 40px; }
    .values-heading { text-align: center; margin-bottom: 48px; }
    .values-heading p { font-size: 11px; letter-spacing: 3px; text-transform: uppercase; color: var(--gold); font-weight: 500; margin-bottom: 12px; }
    .values-heading h2 { font-family: var(--font-serif); font-size: clamp(30px, 3vw, 44px); font-weight: 300; }
    .values-heading h2 em { font-style: italic; }
    .values-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px; }
    .value-card { background: var(--white); border: 1px solid var(--border); padding: 36px 28px; }
    .value-card .value-icon { font-size: 28px; margin-bottom: 16px; }
    .value-card h3 { font-family: var(--font-serif); font-size: 22px; font-weight: 400; margin-bottom: 10px; }
    .value-card p { font-size: 13px; color: var(--mid-grey); line-height: 1.85; }

    /* CTA */
    .about-cta { background: var(--charcoal); color: var(--white); padding: 80px 40px; text-align: center; }
    .about-cta h2 { font-family: var(--font-serif); font-size: clamp(32px, 3.5vw, 52px); font-weight: 300; margin-bottom: 16px; }
    .about-cta h2 em { font-style: italic; }
    .about-cta p { font-size: 14px; color: rgba(255,255,255,0.55); max-width: 500px; margin: 0 auto 36px; line-height: 1.85; }
    .cta-buttons { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
    .btn-light { display: inline-block; padding: 14px 44px; border: 1px solid var(--white); color: var(--white); font-size: 11px; letter-spacing: 2px; text-transform: uppercase; font-weight: 500; transition: all 0.2s; }
    .btn-light:hover { background: var(--white); color: var(--charcoal); }
    .btn-gold { display: inline-block; padding: 14px 44px; background: var(--gold); color: var(--white); font-size: 11px; letter-spacing: 2px; text-transform: uppercase; font-weight: 500; transition: opacity 0.2s; }
    .btn-gold:hover { opacity: 0.85; }

    /* FOOTER */
    .site-footer { background: var(--charcoal); color: var(--white); padding: 48px 0 0; }
    .footer-grid { max-width: 1440px; margin: 0 auto; padding: 0 40px; display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 48px; }
    .footer-logo { width: 220px; height: auto; margin-bottom: 14px; filter: brightness(0) invert(1); opacity: 0.85; }
    .footer-brand p { font-size: 13px; color: rgba(255,255,255,0.5); line-height: 1.8; max-width: 280px; }
    .footer-col h4 { font-size: 10px; letter-spacing: 2.5px; text-transform: uppercase; font-weight: 500; color: rgba(255,255,255,0.5); margin-bottom: 18px; }
    .footer-col ul li { margin-bottom: 10px; }
    .footer-col ul li a { font-size: 13px; color: rgba(255,255,255,0.7); transition: color 0.2s; }
    .footer-col ul li a:hover { color: var(--white); }
    .footer-bottom { max-width: 1440px; margin: 40px auto 0; padding: 18px 40px; border-top: 1px solid rgba(255,255,255,0.1); display: flex; justify-content: space-between; align-items: center; }
    .footer-bottom p { font-size: 12px; color: rgba(255,255,255,0.4); }
    .payment-icon { background: rgba(255,255,255,0.1); border-radius: 3px; padding: 3px 7px; font-size: 10px; color: rgba(255,255,255,0.45); margin-left: 6px; }

    @media (max-width: 900px) {
      .about-promise-inner { grid-template-columns: 1fr; }
      .name-meaning { grid-template-columns: 1fr; }
      .values-grid { grid-template-columns: 1fr 1fr; }
      .footer-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 600px) {
      .header-nav { display: none; }
      .header-inner { padding: 0 20px; }
      .about-intro { padding: 48px 20px 0; }
      .name-meaning { margin: 40px 20px; }
      .about-values { padding: 0 20px; }
      .values-grid { grid-template-columns: 1fr; }
      .about-hero { height: 380px; }
    }
  
    /* Mega Menu */
    .header-nav > li { position: relative; }
    .mega-menu {
      position: absolute; top: calc(100% + 1px);
      left: 0;
      left: 0; transform: none;
      background: var(--white); border: 1px solid var(--border); border-top: none;
      min-width: 680px; padding: 32px 40px; display: none;
      grid-template-columns: repeat(3, 1fr); gap: 32px; z-index: 200;
    }
    .header-nav > li:hover .mega-menu { display: grid; }
    .mega-menu h4 { font-family: var(--font-serif); font-size: 15px; font-weight: 500; letter-spacing: 1px; margin-bottom: 12px; color: var(--charcoal); }
    .mega-menu ul { list-style: none; }
    .mega-menu ul li a { font-size: 12px; color: var(--mid-grey); letter-spacing: 0.5px; padding: 4px 0; display: block; transition: color 0.2s; }
    .mega-menu ul li a:hover { color: var(--charcoal); }
  
    /* Search overlay */
    .search-overlay {
      display: none; position: fixed; inset: 0; z-index: 9999;
      background: rgba(28,28,26,0.5); align-items: flex-start; justify-content: center;
    }
    .search-overlay.open { display: flex; }
    .search-box {
      background: var(--white); width: 100%; max-width: 560px; margin-top: 60px;
      padding: 20px 28px; display: flex; gap: 12px; align-items: center;
      border-bottom: 1px solid var(--border);
    }
    .search-box input {
      flex: 1; border: none; outline: none; font-family: var(--font-sans);
      font-size: 14px; letter-spacing: 0.5px; color: var(--charcoal);
      background: transparent;
    }
    .search-box input::placeholder { color: var(--light-grey); }
    .search-close { background: none; border: none; cursor: pointer; font-size: 20px; color: var(--mid-grey); padding: 4px; }
    .search-close:hover { color: var(--charcoal); }

    @media (max-width: 1280px) {
      .header-inner { padding: 0 24px; }
      .header-nav { gap: 16px; }
    }
</style>

