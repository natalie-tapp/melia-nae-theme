<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --cream: #FAF8F5; --blush: #F2EBE2; --gold: #9C8060; --charcoal: #1C1C1A;
      --mid-grey: #6B6B68; --light-grey: #A8A8A5; --border: #E0D9D0; --white: #FFFFFF;
      --font-serif: 'Cormorant Garamond', Georgia, serif;
      --font-sans: 'Jost', system-ui, sans-serif;
    }
    html { font-size: 16px; }
    body { background: var(--cream); color: var(--charcoal); font-family: var(--font-sans); font-weight: 300; line-height: 1.6; }
    a { text-decoration: none; color: inherit; }
    ul { list-style: none; }

    /* ANNOUNCEMENT BAR */
    .announcement-bar { background: var(--charcoal); color: var(--white); text-align: center; padding: 10px 20px; font-size: 12px; letter-spacing: 1.5px; text-transform: uppercase; display: flex; align-items: center; justify-content: center; gap: 40px; }
    .announcement-bar .divider { opacity: 0.3; }
    .site-top { position: sticky; top: 0; z-index: 100; }
    .site-header { background: var(--white); border-bottom: 1px solid var(--border); }
    .header-inner { max-width: 1440px; margin: 0 auto; padding: 0 40px; display: grid;
      grid-template-columns: 1fr auto 1fr; align-items: center; height: 100px; }
    .header-nav { display: flex; gap: 24px; align-items: center; }
    .header-nav > li { position: relative; }
    .header-nav > li > a { font-size: 11px; letter-spacing: 1.2px; text-transform: uppercase; font-weight: 500; color: var(--charcoal); padding: 8px 0; display: block; transition: color 0.2s; }
    .header-nav > li > a:hover { color: var(--gold); }
    .logo { text-align: center; }
    .logo a img { width: 240px; height: auto; display: block; }
    .header-actions { display: flex; gap: 20px; align-items: center; justify-content: flex-end; }
    .header-actions a { font-size: 12px; letter-spacing: 1.5px; text-transform: uppercase; font-weight: 500; transition: color 0.2s; }
    .header-actions a:hover { color: var(--gold); }
    .cart-count { background: var(--charcoal); color: white; border-radius: 50%; width: 18px; height: 18px; font-size: 10px; display: inline-flex; align-items: center; justify-content: center; margin-left: 4px; }
    .mega-menu { position: absolute; top: calc(100% + 1px);
      left: 0;
      left: 0; background: var(--white); border: 1px solid var(--border); border-top: none; min-width: 680px; padding: 32px 40px; display: none; grid-template-columns: repeat(3, 1fr); gap: 32px; z-index: 200; }
    .header-nav > li:hover .mega-menu { display: grid; }
    .mega-menu h4 { font-family: var(--font-serif); font-size: 15px; font-weight: 500; letter-spacing: 1px; margin-bottom: 12px; }
    .mega-menu ul { list-style: none; }
    .mega-menu ul li a { font-size: 12px; color: var(--mid-grey); letter-spacing: 0.5px; padding: 4px 0; display: block; transition: color 0.2s; }
    .mega-menu ul li a:hover { color: var(--charcoal); }

    /* HERO */
    .contact-hero {
      background: var(--blush);
      border-bottom: 1px solid var(--border);
      min-height: 340px;
      display: flex;
      align-items: flex-end;
      padding: 56px 80px;
      position: relative;
      overflow: hidden;
    }
    .contact-hero::before {
      content: '✦';
      position: absolute; top: -40px; right: 80px;
      font-size: 400px; color: rgba(156,128,96,0.05);
      pointer-events: none; line-height: 1;
    }
    .contact-hero h1 {
      font-family: var(--font-serif);
      font-size: clamp(48px, 6vw, 88px);
      font-weight: 300;
      letter-spacing: 0.04em;
      color: var(--charcoal);
      line-height: 1;
      position: relative;
    }
    .contact-hero h1 em { font-style: italic; color: var(--gold); }

    /* CONTACT LAYOUT */
    .contact-layout {
      max-width: 1200px;
      margin: 0 auto;
      padding: 72px 40px 80px;
      display: grid;
      grid-template-columns: 1fr 1.6fr;
      gap: 80px;
      align-items: start;
    }

    /* LEFT: CONTACT INFO */
    .contact-info .eyebrow {
      font-size: 11px; letter-spacing: 3px; text-transform: uppercase;
      color: var(--gold); font-weight: 500; margin-bottom: 16px;
    }
    .contact-info h2 {
      font-family: var(--font-serif); font-size: clamp(28px, 3vw, 40px);
      font-weight: 300; margin-bottom: 20px;
    }
    .contact-info h2 em { font-style: italic; }
    .contact-info > p {
      font-size: 14px; color: var(--mid-grey); line-height: 1.95; margin-bottom: 40px;
    }

    .contact-method {
      display: flex; align-items: flex-start; gap: 18px;
      padding: 24px 0;
      border-top: 1px solid var(--border);
    }
    .contact-method:last-of-type { border-bottom: 1px solid var(--border); }
    .contact-method-icon {
      width: 44px; height: 44px; border: 1px solid var(--border);
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0; color: var(--gold);
    }
    .contact-method-text .method-label {
      font-size: 10px; letter-spacing: 2px; text-transform: uppercase;
      color: var(--light-grey); font-weight: 500; margin-bottom: 4px;
    }
    .contact-method-text .method-val {
      font-family: var(--font-serif); font-size: 18px; font-weight: 400;
      color: var(--charcoal); margin-bottom: 4px;
    }
    .contact-method-text .method-val a { transition: color 0.2s; }
    .contact-method-text .method-val a:hover { color: var(--gold); }
    .contact-method-text .method-note {
      font-size: 12px; color: var(--mid-grey);
    }

    /* Instagram badge */
    .instagram-link {
      display: inline-flex; align-items: center; gap: 10px;
      padding: 12px 20px;
      border: 1px solid var(--border);
      transition: all 0.2s;
      margin-top: 32px;
      font-size: 13px; letter-spacing: 0.5px;
      color: var(--charcoal);
    }
    .instagram-link:hover { border-color: var(--gold); color: var(--gold); }
    .instagram-link svg { flex-shrink: 0; }

    /* RIGHT: FORM */
    .contact-form-wrap {
      background: var(--white);
      border: 1px solid var(--border);
      padding: 48px 44px;
    }
    .form-eyebrow {
      font-size: 10px; letter-spacing: 2.5px; text-transform: uppercase;
      color: var(--light-grey); font-weight: 500; margin-bottom: 8px;
    }
    .contact-form-wrap h3 {
      font-family: var(--font-serif); font-size: 28px; font-weight: 300;
      margin-bottom: 32px;
    }
    .contact-form-wrap h3 em { font-style: italic; }

    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .form-group { margin-bottom: 20px; }
    .form-group label {
      display: block; font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase;
      font-weight: 500; color: var(--mid-grey); margin-bottom: 8px;
    }
    .form-group input,
    .form-group select,
    .form-group textarea {
      width: 100%;
      border: 1px solid var(--border);
      padding: 12px 16px;
      font-size: 14px;
      font-family: var(--font-sans);
      font-weight: 300;
      color: var(--charcoal);
      background: var(--white);
      transition: border-color 0.2s;
      appearance: none;
    }
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus { outline: none; border-color: var(--gold); }
    .form-group textarea { resize: vertical; min-height: 120px; }
    .form-group select { cursor: pointer; }

    .form-submit {
      display: inline-block; width: 100%;
      padding: 15px 40px;
      background: var(--charcoal); color: var(--white);
      font-size: 11px; letter-spacing: 2px; text-transform: uppercase;
      font-weight: 500; font-family: var(--font-sans);
      border: none; cursor: pointer;
      transition: background 0.2s;
      margin-top: 8px;
    }
    .form-submit:hover { background: var(--gold); }

    .form-note {
      font-size: 12px; color: var(--light-grey); text-align: center;
      margin-top: 16px; line-height: 1.7;
    }
    .form-note a { color: var(--gold); }

    /* SUCCESS STATE */
    .form-success {
      display: none;
      text-align: center;
      padding: 48px 20px;
    }
    .form-success .success-icon { font-size: 40px; color: var(--gold); margin-bottom: 20px; }
    .form-success h3 { font-family: var(--font-serif); font-size: 28px; font-weight: 300; margin-bottom: 12px; }
    .form-success h3 em { font-style: italic; }
    .form-success p { font-size: 14px; color: var(--mid-grey); line-height: 1.85; }

    /* FOOTER */
    .site-footer { background: var(--charcoal); color: var(--white); padding: 48px 0 0; }
    .footer-grid { max-width: 1440px; margin: 0 auto; padding: 0 40px; display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 48px; }
    .footer-logo { width: 220px; height: auto; margin-bottom: 14px; filter: brightness(0) invert(1); opacity: 0.85; }
    .footer-brand p { font-size: 13px; color: rgba(255,255,255,0.5); line-height: 1.8; max-width: 280px; }
    .footer-col h4 { font-size: 10px; letter-spacing: 2.5px; text-transform: uppercase; font-weight: 500; color: rgba(255,255,255,0.5); margin-bottom: 18px; }
    .footer-col ul li { margin-bottom: 10px; }
    .footer-col ul li a { font-size: 13px; color: rgba(255,255,255,0.7); transition: color 0.2s; }
    .footer-col ul li a:hover { color: var(--white); }
    .footer-bottom { max-width: 1440px; margin: 40px auto 0; padding: 18px 40px; border-top: 1px solid rgba(255,255,255,0.1); display: flex; justify-content: space-between; align-items: center; }
    .footer-bottom p { font-size: 12px; color: rgba(255,255,255,0.4); }
    .payment-icon { background: rgba(255,255,255,0.1); border-radius: 3px; padding: 3px 7px; font-size: 10px; color: rgba(255,255,255,0.45); margin-left: 6px; }

    @media (max-width: 900px) {
      .contact-layout { grid-template-columns: 1fr; gap: 40px; }
      .footer-grid { grid-template-columns: 1fr; }
      .contact-hero { padding: 40px 24px; }
    }
    @media (max-width: 600px) {
      .header-nav { display: none; }
      .header-inner { padding: 0 20px; }
      .form-row { grid-template-columns: 1fr; }
      .contact-form-wrap { padding: 32px 24px; }
    }
  
    /* Search overlay */
    .search-overlay {
      display: none; position: fixed; inset: 0; z-index: 9999;
      background: rgba(28,28,26,0.5); align-items: flex-start; justify-content: center;
    }
    .search-overlay.open { display: flex; }
    .search-box {
      background: var(--white); width: 100%; max-width: 560px; margin-top: 60px;
      padding: 20px 28px; display: flex; gap: 12px; align-items: center;
      border-bottom: 1px solid var(--border);
    }
    .search-box input {
      flex: 1; border: none; outline: none; font-family: var(--font-sans);
      font-size: 14px; letter-spacing: 0.5px; color: var(--charcoal);
      background: transparent;
    }
    .search-box input::placeholder { color: var(--light-grey); }
    .search-close { background: none; border: none; cursor: pointer; font-size: 20px; color: var(--mid-grey); padding: 4px; }
    .search-close:hover { color: var(--charcoal); }

    @media (max-width: 1280px) {
      .header-inner { padding: 0 24px; }
      .header-nav { gap: 16px; }
    }
</style>

