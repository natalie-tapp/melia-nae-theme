<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --cream: #FAF8F5;
      --blush: #F2EBE2;
      --warm-nude: #E8DDD2;
      --gold: #9C8060;
      --gold-light: #C4A882;
      --charcoal: #1C1C1A;
      --mid-grey: #6B6B68;
      --light-grey: #A8A8A5;
      --border: #E0D9D0;
      --white: #FFFFFF;
      --font-serif: 'Cormorant Garamond', Georgia, serif;
      --font-sans: 'Jost', system-ui, sans-serif;
    }

    html { font-size: 16px; scroll-behavior: smooth; }
    body { background: var(--cream); color: var(--charcoal); font-family: var(--font-sans); font-weight: 300; line-height: 1.6; }
    img { display: block; max-width: 100%; }
    a { text-decoration: none; color: inherit; }
    ul { list-style: none; }
    button { cursor: pointer; border: none; background: none; font-family: inherit; }

    /* ─── ANNOUNCEMENT BAR ─── */
    .announcement-bar {
      background: var(--charcoal);
      color: var(--white);
      text-align: center;
      padding: 10px 20px;
      font-size: 12px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 40px;
    }
    .announcement-bar span { opacity: 0.9; }
    .announcement-bar .divider { opacity: 0.3; }

    /* ─── STICKY TOP ─── */
    .site-top { position: sticky; top: 0; z-index: 100; }

    /* ─── HEADER ─── */
    .site-header {
      background: var(--white);
      border-bottom: 1px solid var(--border);
    }
    .header-inner {
      max-width: 1440px;
      margin: 0 auto;
      padding: 0 40px;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      height: 100px;
    }
    .header-nav {
      display: flex;
      gap: 24px;
      align-items: center;
    }
    .header-nav > li > a {
      font-size: 11px;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      font-weight: 500;
      color: var(--charcoal);
      padding: 8px 0;
      display: block;
      transition: color 0.2s;
    }
    .header-nav > li > a:hover,
    .header-nav > li > a.active { color: var(--gold); }
    .logo { text-align: center; }
    .logo a { display: inline-block; }
    .logo a img { width: 240px; height: auto; display: block; }
    .header-actions {
      display: flex;
      gap: 20px;
      align-items: center;
      justify-content: flex-end;
    }
    .header-actions a {
      font-size: 12px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      font-weight: 500;
      transition: color 0.2s;
    }
    .header-actions a:hover { color: var(--gold); }
    .cart-count {
      background: var(--charcoal);
      color: white;
      border-radius: 50%;
      width: 18px;
      height: 18px;
      font-size: 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-left: 4px;
    }

    /* ─── BREADCRUMB ─── */
    .breadcrumb {
      max-width: 1440px;
      margin: 0 auto;
      padding: 16px 40px;
      display: flex;
      gap: 8px;
      align-items: center;
      font-size: 12px;
      color: var(--light-grey);
    }
    .breadcrumb a { transition: color 0.2s; }
    .breadcrumb a:hover { color: var(--charcoal); }
    .breadcrumb span { color: var(--charcoal); }

    /* ─── PAGE HERO ─── */
    .page-hero {
      background: var(--charcoal);
      padding: 96px 40px;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .page-hero::before {
      content: '◇';
      position: absolute;
      top: 50%;
      
      transform: translate(-50%, -50%);
      font-size: 500px;
      color: rgba(255,255,255,0.02);
      pointer-events: none;
      line-height: 1;
    }
    .page-hero p {
      font-size: 11px;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--gold-light);
      font-weight: 500;
      margin-bottom: 16px;
    }
    .page-hero h1 {
      font-family: var(--font-serif);
      font-size: clamp(44px, 5vw, 72px);
      font-weight: 300;
      line-height: 1.15;
      color: var(--white);
      margin-bottom: 20px;
    }
    .page-hero h1 em { font-style: italic; color: var(--gold-light); }
    .page-hero .subtitle {
      font-size: 15px;
      color: rgba(255,255,255,0.5);
      max-width: 520px;
      margin: 0 auto 36px;
      line-height: 1.8;
    }
    .hero-cta {
      display: inline-block;
      padding: 14px 40px;
      border: 1px solid rgba(255,255,255,0.3);
      color: var(--white);
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      font-weight: 500;
      transition: all 0.2s;
    }
    .hero-cta:hover { background: var(--white); color: var(--charcoal); }

    /* ─── FILTER TABS ─── */
    .filter-tabs {
      background: var(--white);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 140px;
      z-index: 50;
    }
    .filter-tabs-inner {
      max-width: 1440px;
      margin: 0 auto;
      padding: 0 40px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .filter-tabs-list {
      display: flex;
      gap: 0;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .filter-tabs-list::-webkit-scrollbar { display: none; }
    .filter-tab {
      padding: 18px 24px;
      font-size: 11px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      font-weight: 500;
      color: var(--mid-grey);
      cursor: pointer;
      border-bottom: 2px solid transparent;
      white-space: nowrap;
      transition: all 0.2s;
    }
    .filter-tab:hover { color: var(--charcoal); }
    .filter-tab.active { color: var(--charcoal); border-bottom-color: var(--charcoal); }
    .gallery-count {
      font-size: 12px;
      color: var(--light-grey);
      white-space: nowrap;
      padding: 18px 0;
    }

    /* ─── MASONRY GALLERY ─── */
    .gallery-section {
      padding: 48px 0 80px;
    }
    .gallery-container {
      max-width: 1440px;
      margin: 0 auto;
      padding: 0 40px;
    }

    /* Featured row — 1 large + 2 tall side by side */
    .gallery-featured {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      gap: 12px;
      margin-bottom: 12px;
    }
    .gallery-featured .item-main {
      aspect-ratio: 4/3;
    }
    .gallery-featured .item-tall {
      aspect-ratio: 2/3;
    }

    /* Standard rows */
    .gallery-row {
      display: grid;
      gap: 12px;
      margin-bottom: 12px;
    }
    .gallery-row.cols-4 { grid-template-columns: repeat(4, 1fr); }
    .gallery-row.cols-3 { grid-template-columns: repeat(3, 1fr); }
    .gallery-row.cols-2-3 { grid-template-columns: 2fr 1fr 1fr; }
    .gallery-row.cols-3-2 { grid-template-columns: 1fr 1fr 2fr; }

    /* Individual gallery item */
    .gallery-item {
      position: relative;
      overflow: hidden;
      cursor: pointer;
      background: var(--blush);
    }
    .gallery-item.square { aspect-ratio: 1; }
    .gallery-item.portrait { aspect-ratio: 3/4; }
    .gallery-item.landscape { aspect-ratio: 4/3; }
    .gallery-item.wide { aspect-ratio: 16/9; }

    .gallery-item-bg {
      width: 100%;
      height: 100%;
      transition: transform 0.6s ease;
    }
    .gallery-item:hover .gallery-item-bg { transform: scale(1.05); }

    /* Gradient backgrounds for placeholder images */
    .g1  { background: linear-gradient(135deg, #EDE0D4 0%, #D4C4B0 60%, #C0A890 100%); }
    .g2  { background: linear-gradient(160deg, #E4D8CC 0%, #CABCAC 100%); }
    .g3  { background: linear-gradient(135deg, #DDD4C8 0%, #C8B8A8 100%); }
    .g4  { background: linear-gradient(160deg, #E8DCCE 0%, #D0C0AE 100%); }
    .g5  { background: linear-gradient(135deg, #D8CCBE 0%, #C4B2A0 100%); }
    .g6  { background: linear-gradient(160deg, #E0D4C8 0%, #CCBAAA 100%); }
    .g7  { background: linear-gradient(135deg, #DCCEC2 0%, #C8B6A6 100%); }
    .g8  { background: linear-gradient(160deg, #E6DAD0 0%, #D0BEAE 100%); }
    .g9  { background: linear-gradient(135deg, #D4C8BA 0%, #C0B0A0 100%); }
    .g10 { background: linear-gradient(160deg, #EAE0D6 0%, #D6C8B8 100%); }
    .g11 { background: linear-gradient(135deg, #DAD0C6 0%, #C6B4A4 100%); }
    .g12 { background: linear-gradient(160deg, #E2D8CE 0%, #CEBCAC 100%); }
    .g13 { background: linear-gradient(135deg, #D6CCBF 0%, #C2B0A0 100%); }
    .g14 { background: linear-gradient(160deg, #ECE2D8 0%, #D8C6B4 100%); }
    .g15 { background: linear-gradient(135deg, #DED4CA 0%, #CAB8A6 100%); }
    .g16 { background: linear-gradient(160deg, #E4DAD0 0%, #D0BEB0 100%); }

    /* Icon overlay */
    .gallery-item-icon {
      position: absolute;
      top: 50%;
      
      transform: translate(-50%, -50%);
      font-size: 36px;
      opacity: 0.18;
      pointer-events: none;
    }

    /* Hover overlay */
    .gallery-item-overlay {
      position: absolute;
      inset: 0;
      background: rgba(28,28,26,0);
      transition: background 0.35s;
      display: flex;
      align-items: flex-end;
      padding: 24px;
    }
    .gallery-item:hover .gallery-item-overlay { background: rgba(28,28,26,0.38); }
    .gallery-item-caption {
      opacity: 0;
      transform: translateY(8px);
      transition: opacity 0.3s, transform 0.3s;
    }
    .gallery-item:hover .gallery-item-caption {
      opacity: 1;
      transform: translateY(0);
    }
    .gallery-item-caption h4 {
      font-family: var(--font-serif);
      font-size: 18px;
      font-weight: 300;
      color: var(--white);
      margin-bottom: 2px;
    }
    .gallery-item-caption p {
      font-size: 10px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: rgba(255,255,255,0.65);
    }

    /* Label badge */
    .gallery-label {
      position: absolute;
      top: 14px;
      left: 14px;
      background: rgba(28,28,26,0.7);
      color: var(--white);
      font-size: 9px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      padding: 4px 10px;
      font-weight: 500;
      backdrop-filter: blur(4px);
    }
    .gallery-label.gold-tag {
      background: rgba(156,128,96,0.85);
    }

    /* ─── LOAD MORE ─── */
    .load-more {
      text-align: center;
      padding: 20px 0 40px;
    }
    .btn-load {
      display: inline-block;
      padding: 14px 48px;
      border: 1px solid var(--border);
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      font-weight: 500;
      color: var(--charcoal);
      cursor: pointer;
      font-family: inherit;
      transition: all 0.2s;
      background: var(--white);
    }
    .btn-load:hover { background: var(--charcoal); color: var(--white); border-color: var(--charcoal); }

    /* ─── PROCESS STRIP ─── */
    .process-strip {
      background: var(--blush);
      padding: 72px 0;
      border-top: 1px solid var(--border);
    }
    .process-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 40px;
    }
    .section-header {
      text-align: center;
      margin-bottom: 52px;
    }
    .section-eyebrow {
      font-size: 11px;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--gold);
      font-weight: 500;
      margin-bottom: 12px;
    }
    .section-title {
      font-family: var(--font-serif);
      font-size: clamp(32px, 3.5vw, 48px);
      font-weight: 300;
    }
    .section-title em { font-style: italic; }
    .section-subtitle {
      font-size: 14px;
      color: var(--mid-grey);
      margin-top: 12px;
      max-width: 480px;
      margin-left: auto;
      margin-right: auto;
    }

    .steps-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 24px;
      position: relative;
    }
    .steps-grid::before {
      content: '';
      position: absolute;
      top: 32px;
      left: 10%;
      right: 10%;
      height: 1px;
      background: var(--border);
    }
    .step {
      text-align: center;
      position: relative;
    }
    .step-dot {
      width: 64px;
      height: 64px;
      border: 1px solid var(--border);
      border-radius: 50%;
      background: var(--white);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 20px;
      font-family: var(--font-serif);
      font-size: 22px;
      color: var(--gold);
      position: relative;
      z-index: 1;
    }
    .step-title {
      font-size: 11px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      font-weight: 500;
      margin-bottom: 8px;
    }
    .step-desc {
      font-size: 12px;
      color: var(--mid-grey);
      line-height: 1.7;
    }

    /* ─── TESTIMONIAL ─── */
    .testimonial-strip {
      background: var(--charcoal);
      padding: 72px 40px;
      text-align: center;
    }
    .testimonial-strip blockquote {
      font-family: var(--font-serif);
      font-size: clamp(22px, 2.5vw, 32px);
      font-weight: 300;
      font-style: italic;
      color: var(--white);
      max-width: 800px;
      margin: 0 auto 24px;
      line-height: 1.5;
    }
    .testimonial-strip cite {
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: rgba(255,255,255,0.4);
      font-style: normal;
    }

    /* ─── CTA ─── */
    .services-cta {
      padding: 80px 40px;
      background: var(--cream);
      text-align: center;
    }
    .services-cta h2 {
      font-family: var(--font-serif);
      font-size: 48px;
      font-weight: 300;
      margin-bottom: 16px;
      line-height: 1.2;
    }
    .services-cta h2 em { font-style: italic; color: var(--gold); }
    .services-cta p {
      font-size: 14px;
      color: var(--mid-grey);
      max-width: 480px;
      margin: 0 auto 36px;
      line-height: 1.8;
    }
    .cta-buttons { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
    .btn-primary {
      display: inline-block;
      padding: 14px 40px;
      background: var(--charcoal);
      color: var(--white);
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      font-weight: 500;
      transition: background 0.2s;
    }
    .btn-primary:hover { background: var(--gold); }
    .btn-outline {
      display: inline-block;
      padding: 13px 40px;
      border: 1px solid var(--charcoal);
      color: var(--charcoal);
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      font-weight: 500;
      transition: all 0.2s;
    }
    .btn-outline:hover { background: var(--charcoal); color: var(--white); }

    /* ─── FOOTER ─── */
    .site-footer { background: var(--charcoal); color: var(--white); padding: 64px 0 0; }
    .footer-grid {
      max-width: 1440px;
      margin: 0 auto;
      padding: 0 40px;
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 48px;
    }
    .footer-brand p { font-size: 13px; color: rgba(255,255,255,0.45); line-height: 1.8; max-width: 280px; margin-top: 16px; }
    .footer-logo { width: 220px; height: auto; filter: brightness(0) invert(1); opacity: 0.85; }
    .footer-social { display: flex; gap: 12px; margin-top: 20px; }
    .footer-social a {
      width: 34px; height: 34px;
      border: 1px solid rgba(255,255,255,0.2);
      display: flex; align-items: center; justify-content: center;
      font-size: 12px; transition: border-color 0.2s;
    }
    .footer-social a:hover { border-color: rgba(255,255,255,0.6); }
    .footer-col h4 { font-size: 10px; letter-spacing: 2.5px; text-transform: uppercase; font-weight: 500; color: rgba(255,255,255,0.45); margin-bottom: 20px; }
    .footer-col ul li { margin-bottom: 10px; }
    .footer-col ul li a { font-size: 13px; color: rgba(255,255,255,0.65); transition: color 0.2s; }
    .footer-col ul li a:hover { color: white; }
    .footer-bottom {
      max-width: 1440px; margin: 48px auto 0; padding: 20px 40px;
      border-top: 1px solid rgba(255,255,255,0.1);
      display: flex; justify-content: space-between; align-items: center;
    }
    .footer-bottom p { font-size: 12px; color: rgba(255,255,255,0.35); }
    .payment-icon { background: rgba(255,255,255,0.1); border-radius: 3px; padding: 3px 8px; font-size: 10px; color: rgba(255,255,255,0.45); margin-left: 6px; }

    /* ─── LIGHTBOX ─── */
    .lightbox {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.92);
      z-index: 1000;
      align-items: center;
      justify-content: center;
    }
    .lightbox.open { display: flex; }
    .lightbox-inner {
      position: relative;
      max-width: 800px;
      width: 90%;
    }
    .lightbox-image {
      width: 100%;
    }
    .lightbox-close {
      position: absolute;
      top: -44px;
      right: 0;
      color: white;
      font-size: 28px;
      cursor: pointer;
      opacity: 0.7;
      transition: opacity 0.2s;
    }
    .lightbox-close:hover { opacity: 1; }
    .lightbox-caption {
      padding: 16px 0 0;
      text-align: center;
    }
    .lightbox-caption h4 { font-family: var(--font-serif); font-size: 22px; color: white; font-weight: 300; }
    .lightbox-caption p { font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase; color: rgba(255,255,255,0.45); margin-top: 4px; }

    /* ─── RESPONSIVE ─── */
    @media (max-width: 1280px) {
      .header-inner { padding: 0 24px; }
      .header-nav { gap: 16px; }
    }
    @media (max-width: 1024px) {
      .gallery-featured { grid-template-columns: 1fr 1fr; }
      .gallery-featured .item-main { grid-column: span 2; aspect-ratio: 16/9; }
      .gallery-row.cols-4 { grid-template-columns: repeat(3, 1fr); }
      .gallery-row.cols-2-3, .gallery-row.cols-3-2 { grid-template-columns: repeat(3, 1fr); }
      .steps-grid { grid-template-columns: repeat(3, 1fr); }
      .steps-grid::before { display: none; }
      .footer-grid { grid-template-columns: 1fr 1fr; gap: 32px; }
    }
    @media (max-width: 768px) {
      .header-inner { padding: 0 20px; }
      .header-nav { display: none; }
      .gallery-container { padding: 0 16px; }
      .gallery-featured { grid-template-columns: 1fr; }
      .gallery-featured .item-main { grid-column: span 1; }
      .gallery-row.cols-3, .gallery-row.cols-4 { grid-template-columns: repeat(3, 1fr); }
      .gallery-row.cols-2-3, .gallery-row.cols-3-2 { grid-template-columns: 1fr; }
      .steps-grid { grid-template-columns: repeat(3, 1fr); }
      .footer-grid { grid-template-columns: 1fr; }
    }
  
    /* Mega Menu */
    .header-nav > li { position: relative; }
    .mega-menu {
      position: absolute; top: calc(100% + 1px);
      left: 0;
      left: 0; transform: none;
      background: var(--white); border: 1px solid var(--border); border-top: none;
      min-width: 680px; padding: 32px 40px; display: none;
      grid-template-columns: repeat(3, 1fr); gap: 32px; z-index: 200;
    }
    .header-nav > li:hover .mega-menu { display: grid; }
    .mega-menu h4 { font-family: var(--font-serif); font-size: 15px; font-weight: 500; letter-spacing: 1px; margin-bottom: 12px; color: var(--charcoal); }
    .mega-menu ul { list-style: none; }
    .mega-menu ul li a { font-size: 12px; color: var(--mid-grey); letter-spacing: 0.5px; padding: 4px 0; display: block; transition: color 0.2s; }
    .mega-menu ul li a:hover { color: var(--charcoal); }
  
    /* Search overlay */
    .search-overlay {
      display: none; position: fixed; inset: 0; z-index: 9999;
      background: rgba(28,28,26,0.5); align-items: flex-start; justify-content: center;
    }
    .search-overlay.open { display: flex; }
    .search-box {
      background: var(--white); width: 100%; max-width: 560px; margin-top: 60px;
      padding: 20px 28px; display: flex; gap: 12px; align-items: center;
      border-bottom: 1px solid var(--border);
    }
    .search-box input {
      flex: 1; border: none; outline: none; font-family: var(--font-sans);
      font-size: 14px; letter-spacing: 0.5px; color: var(--charcoal);
      background: transparent;
    }
    .search-box input::placeholder { color: var(--light-grey); }
    .search-close { background: none; border: none; cursor: pointer; font-size: 20px; color: var(--mid-grey); padding: 4px; }
    .search-close:hover { color: var(--charcoal); }
</style>

<!-- HEADER -->
<header class="site-header">
  <div class="header-inner">
        <nav>
      <ul class="header-nav">
        <li><a href="/pages/collection">Shop All</a></li>
        <li>
          <a href="/pages/collection">Jewellery ▾</a>
          <div class="mega-menu">
            <div>
              <h4>Shop By Type</h4>
              <ul>
                <li><a href="collection.html?type=earrings">Earrings</a></li>
                <li><a href="collection.html?type=necklaces">Necklaces</a></li>
                <li><a href="collection.html?type=rings">Rings</a></li>
                <li><a href="collection.html?type=bracelets-bangles">Bracelets &amp; Bangles</a></li>
                <li><a href="collection.html?collection=locket">Lockets</a></li>
                <li><a href="collection.html?collection=our-favourite-products">Best Sellers</a></li>
              </ul>
            </div>
