    .method-num { font-family: var(--font-serif); font-size: 72px; font-weight: 300; color: rgba(156,128,96,0.15); line-height: 1; margin-bottom: 8px; }
    .method-title { font-family: var(--font-serif); font-size: 26px; font-weight: 400; margin-bottom: 20px; }
    .method-title em { font-style: italic; }
    .method-steps { display: flex; flex-direction: column; gap: 14px; }
    .method-step { display: flex; gap: 16px; align-items: flex-start; }
    .method-step-num { width: 24px; height: 24px; border: 1px solid var(--gold); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 11px; color: var(--gold); font-weight: 500; flex-shrink: 0; margin-top: 1px; }
    .method-step p { font-size: 13px; color: var(--mid-grey); line-height: 1.7; }
    .method-tip { margin-top: 24px; padding: 16px 20px; background: var(--blush); font-size: 12px; color: var(--mid-grey); line-height: 1.7; border-left: 2px solid var(--gold); }

    /* ─── INTERACTIVE CALCULATOR ─── */
    .calculator-section { background: var(--charcoal); color: var(--white); padding: 56px 48px; margin-bottom: 72px; display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
