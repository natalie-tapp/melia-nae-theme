    .tip-text { font-size: 13px; color: var(--mid-grey); line-height: 1.7; }

    /* ─── CTA ─── */
    .cta-section { text-align: center; padding: 56px 48px; background: var(--white); border: 1px solid var(--border); }
    .cta-section h2 { font-family: var(--font-serif); font-size: 36px; font-weight: 300; margin-bottom: 12px; }
