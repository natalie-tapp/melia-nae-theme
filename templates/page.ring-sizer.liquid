    .size-table tbody tr.highlight { background: rgba(156,128,96,0.08); }
    .size-table .dash { color: var(--border); }

    /* ─── TIPS ─── */
    .tips-section { background: var(--blush); padding: 56px 48px; margin-bottom: 72px; }
    .tips-heading { text-align: center; margin-bottom: 40px; }
