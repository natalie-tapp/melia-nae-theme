    .calc-widget { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); padding: 32px; }
    .calc-label { font-size: 11px; letter-spacing: 2px; text-transform: uppercase; font-weight: 500; color: rgba(255,255,255,0.5); margin-bottom: 10px; }
    .calc-input-row { display: flex; gap: 0; margin-bottom: 20px; }
    .calc-input {
      flex: 1; padding: 14px 18px; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15);
      border-right: none; color: var(--white); font-size: 15px; font-family: var(--font-sans);
      outline: none; transition: border-color 0.2s;
    }
    .calc-input:focus { border-color: var(--gold); }
    .calc-input::placeholder { color: rgba(255,255,255,0.3); }
    .calc-unit-toggle { display: flex; }
    .unit-btn { padding: 0 18px; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); color: rgba(255,255,255,0.5); font-size: 11px; font-weight: 500; letter-spacing: 1px; cursor: pointer; font-family: var(--font-sans); transition: all 0.2s; }
    .unit-btn.active { background: var(--gold); border-color: var(--gold); color: var(--white); }
    .calc-result { padding: 20px; border: 1px solid rgba(156,128,96,0.4); text-align: center; min-height: 80px; display: flex; flex-direction: column; align-items: center; justify-content: center; }
    .result-label { font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: rgba(255,255,255,0.4); margin-bottom: 8px; }
    .result-size { font-family: var(--font-serif); font-size: 42px; font-weight: 300; color: var(--gold); line-height: 1; }
    .result-sub { font-size: 12px; color: rgba(255,255,255,0.4); margin-top: 6px; }
    .result-placeholder { font-size: 13px; color: rgba(255,255,255,0.3); }

    /* ─── SHAPES ─── */
    .shapes-section { margin-bottom: 72px; }
    .shapes-heading { text-align: center; margin-bottom: 40px; }
