    .shape-svg svg { fill: none; stroke: var(--gold); stroke-width: 1.2; }
    .shape-name { font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase; font-weight: 500; color: var(--mid-grey); }

    /* ─── SIZE TABLE ─── */
    .table-section { margin-bottom: 72px; }
    .table-heading { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 28px; }
