    .size-table th:first-child { text-align: left; }
    .size-table td { padding: 12px 16px; font-size: 13px; text-align: center; border-bottom: 1px solid var(--border); }
    .size-table td:first-child { text-align: left; font-weight: 500; color: var(--gold); }
    .size-table tr:last-child td { border-bottom: none; }
