<style>
/* ─── PAGE HERO ─── */
    .page-hero {
      background: var(--blush);
      padding: 80px 40px;
      text-align: center;
      border-bottom: 1px solid var(--border);
      position: relative;
      overflow: hidden;
    }
    .page-hero::before {
      content: '✦';
      position: absolute;
      top: -20px;
      
      
      font-size: 300px;
      color: rgba(156,128,96,0.06);
      pointer-events: none;
      line-height: 1;
    }
    .page-hero p {
      font-size: 11px;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--gold);
      font-weight: 500;
      margin-bottom: 16px;
    }
    .page-hero h1 {
      font-family: var(--font-serif);
      font-size: clamp(40px, 5vw, 68px);
      font-weight: 300;
      line-height: 1.15;
      margin-bottom: 20px;
    }
    .page-hero h1 em { font-style: italic; color: var(--gold); }
    .page-hero .subtitle {
      font-size: 15px;
      color: var(--mid-grey);
      max-width: 520px;
      margin: 0 auto;
      line-height: 1.8;
    }

    /* ─── SERVICES GRID ─── */
    .services-section {
      padding: 80px 0;
    }
    .container {
      max-width: 1440px;
      margin: 0 auto;
      padding: 0 40px;
    }
    .services-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2px;
    }

    /* ─── SERVICE CARD ─── */
    .service-card {
      background: var(--white);
      padding: 56px 44px;
      border: 1px solid var(--border);
      margin: -1px 0 0 -1px;
      position: relative;
      overflow: hidden;
      transition: box-shadow 0.3s;
    }
    .service-card:hover {
      box-shadow: 0 8px 40px rgba(28,28,26,0.08);
      z-index: 1;
    }
    .service-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 3px;
      height: 0;
      background: var(--gold);
      transition: height 0.35s ease;
    }
    .service-card:hover::before { height: 100%; }

    .service-icon {
      width: 56px;
      height: 56px;
      border: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      margin-bottom: 28px;
      color: var(--gold);
      transition: background 0.25s, border-color 0.25s;
    }
    .service-card:hover .service-icon {
      background: var(--gold);
      border-color: var(--gold);
      color: var(--white);
    }
    .service-number {
      font-size: 10px;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      color: var(--light-grey);
      font-weight: 500;
      margin-bottom: 10px;
    }
    .service-title {
      font-family: var(--font-serif);
      font-size: 28px;
      font-weight: 300;
      line-height: 1.2;
      margin-bottom: 16px;
      color: var(--charcoal);
    }
    .service-title em { font-style: italic; }
    .service-desc {
      font-size: 13px;
      color: var(--mid-grey);
      line-height: 1.9;
      margin-bottom: 28px;
    }
    .service-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      font-weight: 500;
      color: var(--charcoal);
      border-bottom: 1px solid var(--border);
      padding-bottom: 3px;
      transition: border-color 0.2s, color 0.2s;
    }
    .service-link:hover { border-color: var(--gold); color: var(--gold); }
    .service-link span { transition: transform 0.2s; }
    .service-link:hover span { transform: translateX(4px); }

    /* Wide card spanning full width */
    .service-card.wide {
      grid-column: span 3;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 48px;
      align-items: center;
      padding: 64px 56px;
    }
    .service-card.wide .service-content {}
    .service-card.wide .service-visual {
      background: linear-gradient(135deg, #EDE4DC 0%, #D8CCBE 50%, #C4B4A0 100%);
      height: 280px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 80px;
      color: rgba(156,128,96,0.25);
      position: relative;
      overflow: hidden;
    }
    .service-card.wide .service-visual::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, transparent 40%, rgba(28,28,26,0.05) 100%);
    }

    /* ─── PROCESS STRIP ─── */
    .process-strip {
      background: var(--charcoal);
      padding: 64px 0;
    }
    .process-inner {
      max-width: 1440px;
      margin: 0 auto;
      padding: 0 40px;
    }
    .process-heading {
      text-align: center;
      margin-bottom: 48px;
    }
    .process-heading p {
      font-size: 11px;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--gold-light);
      font-weight: 500;
      margin-bottom: 12px;
    }
    .process-heading h2 {
      font-family: var(--font-serif);
      font-size: 36px;
      font-weight: 300;
      color: var(--white);
    }
    .process-heading h2 em { font-style: italic; }
    .process-steps {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
      position: relative;
    }
    .process-steps::before {
      content: '';
      position: absolute;
      top: 28px;
      left: 12.5%;
      right: 12.5%;
      height: 1px;
      background: rgba(255,255,255,0.12);
    }
    .process-step {
      text-align: center;
      padding: 0 24px;
      position: relative;
    }
    .step-number {
      width: 56px;
      height: 56px;
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-serif);
      font-size: 20px;
      color: var(--gold-light);
      margin: 0 auto 20px;
      background: var(--charcoal);
      position: relative;
      z-index: 1;
    }
    .step-title {
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      font-weight: 500;
      color: var(--white);
      margin-bottom: 10px;
    }
    .step-desc {
      font-size: 12px;
      color: rgba(255,255,255,0.45);
      line-height: 1.8;
    }

    /* ─── FAQ ─── */
    .faq-section {
      padding: 80px 0;
      background: var(--blush);
    }
    .faq-inner {
      max-width: 780px;
      margin: 0 auto;
      padding: 0 40px;
    }
    .faq-heading {
      text-align: center;
      margin-bottom: 48px;
    }
    .faq-heading p {
      font-size: 11px;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--gold);
      font-weight: 500;
      margin-bottom: 12px;
    }
    .faq-heading h2 {
      font-family: var(--font-serif);
      font-size: 40px;
      font-weight: 300;
    }
    .faq-heading h2 em { font-style: italic; }
    .faq-item {
      border-bottom: 1px solid var(--border);
    }
    .faq-question {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px 0;
      cursor: pointer;
    }
    .faq-question h4 {
      font-family: var(--font-serif);
      font-size: 18px;
      font-weight: 400;
      color: var(--charcoal);
    }
    .faq-toggle {
      width: 32px;
      height: 32px;
      border: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      color: var(--mid-grey);
      flex-shrink: 0;
      transition: all 0.2s;
    }
    .faq-item.open .faq-toggle {
      background: var(--charcoal);
      border-color: var(--charcoal);
      color: white;
      transform: rotate(45deg);
    }
    .faq-answer {
      display: none;
      padding-bottom: 20px;
      font-size: 13px;
      color: var(--mid-grey);
      line-height: 1.9;
    }
    .faq-item.open .faq-answer { display: block; }

    /* ─── CTA ─── */
    .services-cta {
      padding: 80px 40px;
      background: var(--cream);
      text-align: center;
    }
    .services-cta h2 {
      font-family: var(--font-serif);
      font-size: 48px;
      font-weight: 300;
      margin-bottom: 16px;
      line-height: 1.2;
    }
    .services-cta h2 em { font-style: italic; color: var(--gold); }
    .services-cta p {
      font-size: 14px;
      color: var(--mid-grey);
      max-width: 480px;
      margin: 0 auto 36px;
      line-height: 1.8;
    }
    .cta-buttons { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
    .btn-primary {
      display: inline-block;
      padding: 14px 40px;
      background: var(--charcoal);
      color: var(--white);
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      font-weight: 500;
      transition: background 0.2s;
    }
    .btn-primary:hover { background: var(--gold); }
    .btn-outline {
      display: inline-block;
      padding: 13px 40px;
      border: 1px solid var(--charcoal);
      color: var(--charcoal);
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      font-weight: 500;
      transition: all 0.2s;
    }
    .btn-outline:hover { background: var(--charcoal); color: var(--white); }

    /* ─── RESPONSIVE ─── */
    @media (max-width: 1280px) {
    }
    @media (max-width: 1024px) {
      .services-grid { grid-template-columns: repeat(3, 1fr); }
      .service-card.wide { grid-column: span 2; }
      .process-steps { grid-template-columns: repeat(3, 1fr); gap: 32px; }
      .process-steps::before { display: none; }
    }
    @media (max-width: 768px) {
      .container { padding: 0 20px; }
      .services-grid { grid-template-columns: 1fr; }
      .service-card.wide { grid-column: span 1; grid-template-columns: 1fr; }
      .service-card.wide .service-visual { display: block; height: 260px; }
      .process-steps { grid-template-columns: 1fr 1fr; }
      .page-hero { padding: 56px 24px; }
    }
  
    /* Mega Menu */
  
    /* Search overlay */
</style>



