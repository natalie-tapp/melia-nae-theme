<!-- BREADCRUMB -->
<nav class="breadcrumb">
  <a href="/">Home</a> /
  <a href="{{ product.collections.first.url | default: routes.all_products_collection_url }}">
    {{ product.collections.first.title | default: 'Shop All' }}
  </a> /
  <span>{{ product.title }}</span>
</nav>

<!-- PRODUCT LAYOUT -->
<div class="product-layout">

  <!-- GALLERY -->
  <div class="gallery" id="productGallery">
    <div class="gallery-thumbs" id="galleryThumbs">
      {%- for image in product.images -%}
        <div class="gallery-thumb {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}">
          <img src="{{ image | img_url: '160x160', crop: 'center' }}"
               alt="{{ image.alt | default: product.title | escape }}"
               class="gallery-thumb-bg"
               loading="lazy" />
        </div>
      {%- endfor -%}
    </div>
    <div class="gallery-main">
      {%- if product.featured_image -%}
        <img id="mainImg"
             src="{{ product.featured_image | img_url: '1200x' }}"
             alt="{{ product.featured_image.alt | default: product.title | escape }}"
             class="gallery-main-bg" />
      {%- endif -%}
      {%- if product.images.size > 1 -%}
        <div class="gallery-nav">
          <button type="button" class="gallery-prev" id="galleryPrev" aria-label="Previous image">‹</button>
          <button type="button" class="gallery-next" id="galleryNext" aria-label="Next image">›</button>
        </div>
      {%- endif -%}
      <div class="gallery-zoom-hint">Hover to zoom</div>
    </div>
  </div>

  <script>
    // Gallery image URLs from Shopify (safe — no inline quote issues)
    window.__galleryImages = [
      {%- for image in product.images -%}
        {
          full: {{ image | img_url: '1200x' | json }},
          thumb: {{ image | img_url: '160x160', crop: 'center' | json }},
          alt: {{ image.alt | default: product.title | json }},
          variantIds: {{ image.variants | map: 'id' | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ];

    (function() {
      var images  = window.__galleryImages;
      if (!images || images.length === 0) return;

      var mainImg = document.getElementById('mainImg');
      var thumbs  = document.querySelectorAll('.gallery-thumb');
      var prev    = document.getElementById('galleryPrev');
      var next    = document.getElementById('galleryNext');
      var current = 0;

      function goTo(index) {
        current = (index + images.length) % images.length;
        if (mainImg) {
          mainImg.src = images[current].full;
          mainImg.alt = images[current].alt || '';
        }
        thumbs.forEach(function(t, i) {
          t.classList.toggle('active', i === current);
        });
      }

      // Thumbnail clicks
      thumbs.forEach(function(thumb) {
        thumb.addEventListener('click', function() {
          goTo(parseInt(this.dataset.index, 10));
        });
      });

      // Prev / Next
      if (prev) prev.addEventListener('click', function() { goTo(current - 1); });
      if (next) next.addEventListener('click', function() { goTo(current + 1); });

      // Expose so updateVariant() can switch to variant image
      window.__galleryGoTo = goTo;
    })();
  </script>

  <!-- PRODUCT DETAILS -->
  <div class="product-details">
    <div class="product-meta">
      <span class="product-brand">{{ shop.name }}</span>
      <button class="product-wishlist-btn" data-wishlist-id="{{ product.id }}" data-wishlist-handle="{{ product.handle }}" data-wishlist-title="{{ product.title | escape }}" data-wishlist-price="{{ product.price | money }}" data-wishlist-image="{{ product.featured_image | img_url: '400x400', crop: 'center' }}" aria-label="Add to wishlist">♡ Wishlist</button>
    </div>

    <h1 class="product-title">{{ product.title }}</h1>

    <div class="product-price-wrap">
      {%- if product.compare_at_price > product.price -%}
        <span class="product-price-original">{{ product.compare_at_price | money }}</span>
        <span class="product-price product-price-sale" id="product-price">{{ product.price | money }}</span>
      {%- else -%}
        <span class="product-price" id="product-price">{{ product.price | money }}</span>
      {%- endif -%}
    </div>
    <p class="product-afterpay">
      or <strong>4 payments of {{ product.price | divided_by: 4 | money }}</strong> with Afterpay
    </p>

{%- form 'product', product, id: 'product-form' -%}

      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          {%- assign opt_index = option.position | minus: 1 -%}
          <div class="option-group">
            <div class="option-label">
              {{ option.name | replace: 'Color', 'Colour' | replace: 'color', 'colour' }}
              {%- if option.name == 'Length' or option.name == 'Size' -%}
                <a class="size-guide" href="/pages/size-guide">Size Guide</a>
              {%- endif -%}
            </div>
            <div class="option-swatches">
              {%- for value in option.values -%}
                {%- assign value_available = false -%}
                {%- for variant in product.variants -%}
                  {%- if variant.options[opt_index] == value and variant.available -%}
                    {%- assign value_available = true -%}
                  {%- endif -%}
                {%- endfor -%}
                <button type="button"
                        class="swatch-btn {% if forloop.first %}active{% endif %} {% unless value_available %}soldout{% endunless %}"
                        data-option="{{ option.position }}"
                        data-value="{{ value | escape }}"
                        onclick="updateVariant(this)">
                  {{ value }}
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
      {%- endunless -%}

      <input type="hidden" name="id" id="variant-id" value="{{ product.selected_or_first_available_variant.id }}" />
      <input type="hidden" name="quantity" id="quantity-input" value="1" />

      <div class="add-to-cart-wrap">
        <div class="quantity-and-cart">
          <div class="quantity-selector">
            <div class="qty-btn minus" onclick="adjustQty(-1)">−</div>
            <div class="qty-display" id="qty">1</div>
            <div class="qty-btn plus" onclick="adjustQty(1)">+</div>
          </div>
          <button type="submit" name="add" class="btn-add-cart">
            {%- if product.available -%}Add to Bag{%- else -%}Sold Out{%- endif -%}
          </button>
        </div>
        <button type="button" class="btn-wishlist" data-wishlist-id="{{ product.id }}" data-wishlist-handle="{{ product.handle }}" data-wishlist-title="{{ product.title | escape }}" data-wishlist-price="{{ product.price | money }}" data-wishlist-image="{{ product.featured_image | img_url: '400x400', crop: 'center' }}" aria-label="Add to wishlist">♡ Add to Wishlist</button>
      </div>

    {%- endform -%}

    <!-- TRUST BADGES -->
    <div class="trust-badges">
      <div class="trust-badge">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span>Certified Fine Jewellery</span>
      </div>
      <div class="trust-badge">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <span>Secure Checkout</span>
      </div>
      <div class="trust-badge">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
        <span>Free Shipping $150+</span>
      </div>
      <div class="trust-badge">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        <span>Australian Owned</span>
      </div>
    </div>

    <div class="delivery-info">
      <div class="delivery-info-icon">✈</div>
      <div class="delivery-info-text">
        <h5>Free Shipping over $150 AUD</h5>
        <p>Estimated delivery 3–7 business days. Express available at checkout.</p>
      </div>
    </div>

    <div class="accordion">
      <div class="accordion-item">
        <div class="accordion-header">
          <h4>Description</h4>
          <span>+</span>
        </div>
        <div class="accordion-body">
          {{ product.description }}
        </div>
      </div>
      <div class="accordion-item">
        <div class="accordion-header">
          <h4>Details &amp; Specifications</h4>
          <span>+</span>
        </div>
        <div class="accordion-body">
          <ul>
            {%- comment -%}Metal — extract from title (preserves karat e.g. 9K Yellow Gold){%- endcomment -%}
            {%- assign metal = '' -%}
            {%- assign t = product.title -%}
            {%- if t contains '24K' or t contains '22K' or t contains '18K' or t contains '14K' or t contains '10K' or t contains '9K' -%}
              {%- if t contains '24K Yellow Gold' -%}{%- assign metal = '24K Yellow Gold' -%}
              {%- elsif t contains '22K Yellow Gold' -%}{%- assign metal = '22K Yellow Gold' -%}
              {%- elsif t contains '18K Rose Gold' -%}{%- assign metal = '18K Rose Gold' -%}
              {%- elsif t contains '18K Yellow Gold' -%}{%- assign metal = '18K Yellow Gold' -%}
              {%- elsif t contains '18K White Gold' -%}{%- assign metal = '18K White Gold' -%}
              {%- elsif t contains '18K Gold' -%}{%- assign metal = '18K Gold' -%}
              {%- elsif t contains '14K Rose Gold' -%}{%- assign metal = '14K Rose Gold' -%}
              {%- elsif t contains '14K Yellow Gold' -%}{%- assign metal = '14K Yellow Gold' -%}
              {%- elsif t contains '14K White Gold' -%}{%- assign metal = '14K White Gold' -%}
              {%- elsif t contains '14K Gold' -%}{%- assign metal = '14K Gold' -%}
              {%- elsif t contains '10K Rose Gold' -%}{%- assign metal = '10K Rose Gold' -%}
              {%- elsif t contains '10K Yellow Gold' -%}{%- assign metal = '10K Yellow Gold' -%}
              {%- elsif t contains '10K White Gold' -%}{%- assign metal = '10K White Gold' -%}
              {%- elsif t contains '10K Gold' -%}{%- assign metal = '10K Gold' -%}
              {%- elsif t contains '9K Rose Gold' -%}{%- assign metal = '9K Rose Gold' -%}
              {%- elsif t contains '9K Yellow Gold' -%}{%- assign metal = '9K Yellow Gold' -%}
              {%- elsif t contains '9K White Gold' -%}{%- assign metal = '9K White Gold' -%}
              {%- elsif t contains '9K Gold' -%}{%- assign metal = '9K Gold' -%}
              {%- endif -%}
            {%- endif -%}
            {%- if metal == blank -%}
              {%- if t contains '925' or t contains 'Sterling Silver' -%}{%- assign metal = '925 Sterling Silver' -%}
              {%- elsif t contains 'Rose Gold' -%}{%- assign metal = 'Rose Gold' -%}
              {%- elsif t contains 'Yellow Gold' -%}{%- assign metal = 'Yellow Gold' -%}
              {%- elsif t contains 'White Gold' -%}{%- assign metal = 'White Gold' -%}
              {%- elsif t contains 'Gold' -%}{%- assign metal = 'Gold' -%}
              {%- elsif t contains 'Silver' -%}{%- assign metal = 'Sterling Silver' -%}
              {%- elsif t contains 'Platinum' -%}{%- assign metal = 'Platinum' -%}
              {%- endif -%}
            {%- endif -%}
            {%- if metal != blank %}<li>Metal: {{ metal }}</li>{%- endif -%}

            {%- comment -%}Stone type — from title{%- endcomment -%}
            {%- assign stone = '' -%}
            {%- if t contains 'Lab Grown Diamond' or t contains 'Lab-Grown Diamond' or t contains 'Lab Diamond' -%}{%- assign stone = 'Lab Grown Diamond' -%}
            {%- elsif t contains 'Moissanite' -%}{%- assign stone = 'Moissanite' -%}
            {%- elsif t contains 'Natural Diamond' -%}{%- assign stone = 'Natural Diamond' -%}
            {%- elsif t contains 'Diamond' -%}{%- assign stone = 'Diamond' -%}
            {%- elsif t contains 'Sapphire' -%}{%- assign stone = 'Sapphire' -%}
            {%- elsif t contains 'Ruby' -%}{%- assign stone = 'Ruby' -%}
            {%- elsif t contains 'Emerald' -%}{%- assign stone = 'Emerald' -%}
            {%- elsif t contains 'Pearl' -%}{%- assign stone = 'Pearl' -%}
            {%- elsif t contains 'Opal' -%}{%- assign stone = 'Opal' -%}
            {%- elsif t contains 'Cubic Zirconia' or t contains 'CZ' -%}{%- assign stone = 'Cubic Zirconia' -%}
            {%- endif -%}
            {%- if stone != blank %}<li>Stone: {{ stone }}</li>{%- endif -%}

            {%- comment -%}Product type (if not generic){%- endcomment -%}
            {%- assign type_display = product.type -%}
            {%- unless type_display == blank or type_display == 'Fine Jewellery' or type_display == 'Jewellery' -%}
              <li>Type: {{ type_display | capitalize }}</li>
            {%- endunless -%}

            {%- comment -%}Variant options (e.g. Stone) — skip Size when multiple sizes exist{%- endcomment -%}
            {%- for option in product.options_with_values -%}
              {%- assign opt_lower = option.name | downcase -%}
              {%- unless opt_lower == 'metal' or opt_lower == 'material' or opt_lower == 'colour' or opt_lower == 'color' or opt_lower == 'title' -%}
                {%- if opt_lower == 'size' and option.values.size > 1 -%}
                  {%- comment -%}Multiple sizes — customer selects, skip spec{%- endcomment -%}
                {%- else -%}
                  <li>{{ option.name }}: {{ product.selected_or_first_available_variant.options[forloop.index0] }}</li>
                {%- endif -%}
              {%- endunless -%}
            {%- endfor -%}
          </ul>
        </div>
      </div>
      <div class="accordion-item">
        <div class="accordion-header">
          <h4>Shipping</h4>
          <span>+</span>
        </div>
        <div class="accordion-body">
          <p>Free standard shipping on all Australian orders over $150 AUD. Express shipping available at checkout. International shipping available via Australia Post. <a href="/pages/shipping" style="color:var(--gold);border-bottom:1px solid var(--gold);">View shipping info →</a></p>
        </div>
      </div>
      <div class="accordion-item">
        <div class="accordion-header">
          <h4>Care Guide</h4>
          <span>+</span>
        </div>
        <div class="accordion-body">
          {%- if metal contains 'Gold' -%}
            <p>Store in the pouch provided. Avoid contact with perfume and chemicals. Polish with a soft cloth.</p>
          {%- else -%}
            <p>Store in the pouch provided. Avoid contact with perfume, chemicals, and water. Polish with a soft cloth.</p>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

<!-- STICKY MOBILE ADD TO BAG -->
<div id="sticky-atc" class="sticky-atc" style="display:none;">
  <div class="sticky-atc-info">
    <p class="sticky-atc-title">{{ product.title | truncate: 30 }}</p>
    <p class="sticky-atc-price">{{ product.price | money }}</p>
  </div>
  <button class="sticky-atc-btn" onclick="document.getElementById('product-form').querySelector('[name=add]').click()">
    Add to Bag
  </button>
</div>

<!-- RELATED PRODUCTS -->
{%- assign related_collection = product.collections.first -%}
{%- if related_collection -%}
<section class="related">
  <div class="container">
    <div class="related-header">
      <h2>You May Also <em>Love</em></h2>
      <a href="{{ related_collection.url }}" style="font-size:11px;letter-spacing:1.5px;text-transform:uppercase;border-bottom:1px solid var(--charcoal);">View All →</a>
    </div>
    <div class="related-grid">
      {%- for p in related_collection.products limit: 4 -%}
        {%- unless p.id == product.id -%}
          {%- render 'product-card', product: p -%}
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

<!-- RECENTLY VIEWED -->
<section class="recently-viewed" id="recently-viewed" style="display:none;">
  <div class="container">
    <div class="related-header">
      <h2>Recently <em>Viewed</em></h2>
    </div>
    <div class="related-grid" id="recently-viewed-grid"></div>
  </div>
</section>

<!-- PRODUCT SCHEMA (Google Rich Results) -->
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "image": [{% for image in product.images %}"{{ image | img_url: '1200x' }}"{% unless forloop.last %},{% endunless %}{% endfor %}],
  "description": {{ product.description | strip_html | json }},
  "sku": {{ product.selected_or_first_available_variant.sku | json }},
  "brand": { "@type": "Brand", "name": {{ shop.name | json }} },
  "offers": {
    "@type": "Offer",
    "url": "{{ shop.url }}{{ product.url }}",
    "priceCurrency": "AUD",
    "price": "{{ product.price | divided_by: 100.0 }}",
    "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
    "seller": { "@type": "Organization", "name": {{ shop.name | json }} }
  }
}
</script>

<script>
  // Quantity (accordion + gallery zoom/nav + add-to-cart are wired globally in theme.js)
  let qty = 1;
  function adjustQty(delta) {
    qty = Math.max(1, qty + delta);
    document.getElementById('qty').textContent = qty;
    document.getElementById('quantity-input').value = qty;
  }

  // Sticky mobile ATC
  (function() {
    var stickyBar = document.getElementById('sticky-atc');
    var addBtn = document.querySelector('#product-form [name="add"]');
    if (!stickyBar || !addBtn) return;
    var obs = new IntersectionObserver(function(entries) {
      stickyBar.style.display = entries[0].isIntersecting ? 'none' : 'flex';
    }, { threshold: 0.1 });
    obs.observe(addBtn);
  })();

  // Recently viewed — save current product
  (function() {
    var key = 'mn_recent';
    var item = {
      id: {{ product.id }},
      handle: '{{ product.handle }}',
      title: {{ product.title | json }},
      price: '{{ product.price | money }}',
      image: '{{ product.featured_image | img_url: "400x400", crop: "center" }}'
    };
    var list = [];
    try { list = JSON.parse(localStorage.getItem(key)) || []; } catch(e) {}
    list = list.filter(function(p) { return String(p.id) !== String(item.id); });
    list.unshift(item);
    list = list.slice(0, 7);
    try { localStorage.setItem(key, JSON.stringify(list)); } catch(e) {}

    // Render recently viewed (excluding current)
    var show = list.filter(function(p) { return String(p.id) !== String(item.id); }).slice(0, 4);
    if (show.length) {
      var section = document.getElementById('recently-viewed');
      var grid = document.getElementById('recently-viewed-grid');
      if (section && grid) {
        grid.innerHTML = show.map(function(p) {
          return '<a href="/products/' + p.handle + '" class="product-card">'
            + '<div class="product-card-image">'
            + (p.image ? '<img src="' + p.image + '" alt="' + p.title.replace(/"/g,'&quot;') + '" class="product-card-image-bg" loading="lazy"/>' : '<div class="product-card-image-bg" style="background:var(--blush)"></div>')
            + '</div>'
            + '<p class="product-card-brand">Melia Nae</p>'
            + '<h3 class="product-card-name">' + p.title + '</h3>'
            + '<p class="product-card-price">' + p.price + '</p>'
            + '</a>';
        }).join('');
        section.style.display = '';
      }
    }
  })();

  // Build variant → image lookup from product images
  const variantImageMap = {};
  {{ product.images | json }}.forEach(function(img) {
    if (img.variant_ids && img.variant_ids.length > 0) {
      img.variant_ids.forEach(function(vid) {
        variantImageMap[vid] = img.src;
      });
    }
  });

  function shopifyImageSize(src, size) {
    return src.split('?')[0]
      .replace(/_\d+x\d*(\.[a-zA-Z]+)$/, '$1')
      .replace(/(\.[a-zA-Z]+)$/, '_' + size + '$1');
  }

  // Variant selection

<script id="mn-variants-data" type="application/json">{{ product.variants | json | replace: '</', '\u003c/' }}</script>
  // updateVariant defined in variant-selector.js
      // Update price
      const priceEl = document.getElementById('product-price');
      if (priceEl && match.price) {
        const formatted = (match.price / 100).toLocaleString('en-AU', { style: 'currency', currency: 'AUD' });
        priceEl.textContent = formatted;
      }
    }
  }
</script>
