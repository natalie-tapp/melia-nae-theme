<!-- BREADCRUMB -->
<nav class="breadcrumb">
  <a href="/">Home</a> /
  <a href="{{ product.collections.first.url | default: routes.all_products_collection_url }}">
    {{ product.collections.first.title | default: 'Shop All' }}
  </a> /
  <span>{{ product.title }}</span>
</nav>

<!-- PRODUCT LAYOUT -->
<div class="product-layout">

  <!-- GALLERY -->
  <div class="gallery">
    <div class="gallery-thumbs">
      {%- for image in product.images -%}
        <div class="gallery-thumb {% if forloop.first %}active{% endif %}"
             onclick="document.getElementById('mainImg').src='{{ image | img_url: '1200x' }}'; document.querySelectorAll('.gallery-thumb').forEach(t=>t.classList.remove('active')); this.classList.add('active')">
          <img src="{{ image | img_url: '160x160', crop: 'center' }}"
               alt="{{ image.alt | default: product.title | escape }}"
               class="gallery-thumb-bg" />
        </div>
      {%- endfor -%}
    </div>
    <div class="gallery-main">
      {%- if product.featured_image -%}
        <img id="mainImg"
             src="{{ product.featured_image | img_url: '1200x' }}"
             alt="{{ product.featured_image.alt | default: product.title | escape }}"
             class="gallery-main-bg" />
      {%- endif -%}
      {%- if product.images.size > 1 -%}
        <div class="gallery-nav">
          <button type="button" class="gallery-prev" aria-label="Previous image">‹</button>
          <button type="button" class="gallery-next" aria-label="Next image">›</button>
        </div>
      {%- endif -%}
      <div class="gallery-zoom-hint">Hover to zoom</div>
    </div>
  </div>

  <!-- PRODUCT DETAILS -->
  <div class="product-details">
    <div class="product-meta">
      <span class="product-brand">{{ shop.name }}</span>
      <button class="product-wishlist-btn">♡ Wishlist</button>
    </div>

    <h1 class="product-title">{{ product.title }}</h1>

    <div class="product-price-wrap">
      {%- if product.compare_at_price > product.price -%}
        <span class="product-price-original">{{ product.compare_at_price | money }}</span>
        <span class="product-price product-price-sale">{{ product.price | money }}</span>
      {%- else -%}
        <span class="product-price">{{ product.price | money }}</span>
      {%- endif -%}
    </div>
    <p class="product-afterpay">
      or <strong>4 payments of {{ product.price | divided_by: 4 | money }}</strong> with Afterpay
    </p>

    <div class="product-reviews">
      <span class="review-stars">★★★★★</span>
      <span class="review-count">4.9 · 48 reviews</span>
    </div>

    {%- form 'product', product, id: 'product-form' -%}

      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          {%- assign opt_index = option.position | minus: 1 -%}
          <div class="option-group">
            <div class="option-label">
              {{ option.name }}
              {%- if option.name == 'Length' or option.name == 'Size' -%}
                <a class="size-guide" href="/pages/size-guide">Size Guide</a>
              {%- endif -%}
            </div>
            <div class="option-swatches">
              {%- for value in option.values -%}
                {%- assign value_available = false -%}
                {%- for variant in product.variants -%}
                  {%- if variant.options[opt_index] == value and variant.available -%}
                    {%- assign value_available = true -%}
                  {%- endif -%}
                {%- endfor -%}
                <button type="button"
                        class="swatch-btn {% if forloop.first %}active{% endif %} {% unless value_available %}soldout{% endunless %}"
                        data-option="{{ option.position }}"
                        data-value="{{ value | escape }}"
                        onclick="updateVariant(this)">
                  {{ value }}
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
      {%- endunless -%}

      <input type="hidden" name="id" id="variant-id" value="{{ product.selected_or_first_available_variant.id }}" />
      <input type="hidden" name="quantity" id="quantity-input" value="1" />

      <div class="add-to-cart-wrap">
        <div class="quantity-and-cart">
          <div class="quantity-selector">
            <div class="qty-btn minus" onclick="adjustQty(-1)">−</div>
            <div class="qty-display" id="qty">1</div>
            <div class="qty-btn plus" onclick="adjustQty(1)">+</div>
          </div>
          <button type="submit" name="add" class="btn-add-cart">
            {%- if product.available -%}Add to Bag{%- else -%}Sold Out{%- endif -%}
          </button>
        </div>
        <button type="button" class="btn-wishlist">♡ Add to Wishlist</button>
      </div>

    {%- endform -%}

    <div class="delivery-info">
      <div class="delivery-info-icon">✈</div>
      <div class="delivery-info-text">
        <h5>Free Shipping over $150 AUD</h5>
        <p>Estimated delivery 3–7 business days. Express available at checkout.</p>
      </div>
    </div>

    <div class="accordion">
      <div class="accordion-item">
        <div class="accordion-header">
          <h4>Description</h4>
          <span>+</span>
        </div>
        <div class="accordion-body">
          {{ product.description }}
        </div>
      </div>
      <div class="accordion-item">
        <div class="accordion-header">
          <h4>Details &amp; Specifications</h4>
          <span>+</span>
        </div>
        <div class="accordion-body">
          <ul>
            {%- comment -%}Output structured tags (Key:Value format){%- endcomment -%}
            {%- for tag in product.tags -%}
              {%- if tag contains ':' -%}
                {%- assign tag_parts = tag | split: ':' -%}
                {%- assign tag_key = tag_parts[0] | strip -%}
                {%- assign tag_val = tag_parts[1] | strip -%}
                {%- unless tag_val == blank or tag_val == 'Fine Jewellery' or tag_val == 'Jewellery' -%}
                  <li>{{ tag_key }}: {{ tag_val }}</li>
                {%- endunless -%}
              {%- endif -%}
            {%- endfor -%}
            {%- comment -%}Metal from variant option or title if not in tags{%- endcomment -%}
            {%- assign has_metal_tag = false -%}
            {%- for tag in product.tags -%}
              {%- if tag contains 'Metal:' or tag contains 'metal:' -%}{%- assign has_metal_tag = true -%}{%- endif -%}
            {%- endfor -%}
            {%- unless has_metal_tag -%}
              {%- assign metal = '' -%}
              {%- if product.title contains 'Rose Gold' -%}{%- assign metal = 'Rose Gold' -%}
              {%- elsif product.title contains 'Yellow Gold' -%}{%- assign metal = 'Yellow Gold' -%}
              {%- elsif product.title contains 'White Gold' -%}{%- assign metal = 'White Gold' -%}
              {%- elsif product.title contains 'Gold' -%}{%- assign metal = 'Gold' -%}
              {%- elsif product.title contains 'Silver' -%}{%- assign metal = 'Sterling Silver' -%}
              {%- elsif product.title contains 'Platinum' -%}{%- assign metal = 'Platinum' -%}
              {%- endif -%}
              {%- comment -%}Also check variant option names{%- endcomment -%}
              {%- for option in product.options -%}
                {%- assign opt_lower = option | downcase -%}
                {%- if opt_lower == 'metal' or opt_lower == 'material' or opt_lower == 'colour' or opt_lower == 'color' -%}
                  {%- assign metal = product.selected_or_first_available_variant.options[forloop.index0] -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if metal != blank -%}
                <li>Metal: {{ metal }}</li>
              {%- endif -%}
            {%- endunless -%}
          </ul>
        </div>
      </div>
      <div class="accordion-item">
        <div class="accordion-header">
          <h4>Shipping &amp; Returns</h4>
          <span>+</span>
        </div>
        <div class="accordion-body">
          <p>Free shipping on all orders over $150 AUD. Express shipping available. Returns accepted within 30 days.</p>
        </div>
      </div>
      <div class="accordion-item">
        <div class="accordion-header">
          <h4>Care Guide</h4>
          <span>+</span>
        </div>
        <div class="accordion-body">
          <p>Store in the pouch provided. Avoid contact with perfume, chemicals, and water. Polish with a soft cloth.</p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- RELATED PRODUCTS -->
{%- assign related_collection = product.collections.first -%}
{%- if related_collection -%}
<section class="related">
  <div class="container">
    <div class="related-header">
      <h2>You May Also <em>Love</em></h2>
      <a href="{{ related_collection.url }}" style="font-size:11px;letter-spacing:1.5px;text-transform:uppercase;border-bottom:1px solid var(--charcoal);">View All →</a>
    </div>
    <div class="related-grid">
      {%- for p in related_collection.products limit: 4 -%}
        {%- unless p.id == product.id -%}
          {%- render 'product-card', product: p -%}
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

<script>
  // Quantity (accordion + gallery zoom/nav + add-to-cart are wired globally in theme.js)
  let qty = 1;
  function adjustQty(delta) {
    qty = Math.max(1, qty + delta);
    document.getElementById('qty').textContent = qty;
    document.getElementById('quantity-input').value = qty;
  }

  // Variant selection
  function updateVariant(btn) {
    const group = btn.closest('.option-swatches');
    group.querySelectorAll('.swatch-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    // Collect all selected options
    const selected = [];
    document.querySelectorAll('.option-swatches').forEach(g => {
      const active = g.querySelector('.swatch-btn.active');
      if (active) selected.push(active.dataset.value);
    });
    // Find matching variant
    const variants = {{ product.variants | json }};
    const match = variants.find(v => {
      return selected.every((s, i) => v['option' + (i + 1)] === s);
    });
    if (match) {
      document.getElementById('variant-id').value = match.id;
    }
  }
</script>
