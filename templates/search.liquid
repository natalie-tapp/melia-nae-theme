<style>
  .search-page { max-width: 1200px; margin: 0 auto; padding: 48px 24px 80px; }
  .search-page-header { text-align: center; margin-bottom: 40px; }
  .search-page-header .eyebrow { font-size: 11px; letter-spacing: 3px; text-transform: uppercase; color: var(--gold); font-weight: 500; display: block; margin-bottom: 12px; }
  .search-page-header h1 { font-family: var(--font-serif); font-size: clamp(28px, 4vw, 42px); font-weight: 300; margin-bottom: 8px; }
  .search-page-header p { font-size: 14px; color: var(--mid-grey); }

  .search-form { display: flex; max-width: 560px; margin: 0 auto 48px; border: 1px solid var(--border); }
  .search-form input { flex: 1; border: none; padding: 14px 20px; font-size: 14px; font-family: var(--font-sans); background: var(--white); color: var(--charcoal); outline: none; }
  .search-form button { background: var(--charcoal); color: var(--white); border: none; padding: 14px 24px; font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase; font-family: var(--font-sans); cursor: pointer; white-space: nowrap; }
  .search-form button:hover { background: var(--gold); }

  .search-count { font-size: 12px; color: var(--mid-grey); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 24px; }

  .search-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px; }
  .search-card { background: var(--white); display: block; color: inherit; text-decoration: none; }
  .search-card-img { aspect-ratio: 1; overflow: hidden; background: var(--blush); }
  .search-card-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s ease; }
  .search-card:hover .search-card-img img { transform: scale(1.04); }
  .search-card-info { padding: 14px 12px 20px; }
  .search-card-name { font-family: var(--font-serif); font-size: 15px; font-weight: 400; margin-bottom: 4px; line-height: 1.4; }
  .search-card-price { font-size: 13px; color: var(--mid-grey); letter-spacing: 0.5px; }

  .search-no-results-msg { text-align: center; padding: 60px 20px; }
  .search-no-results-msg h2 { font-family: var(--font-serif); font-size: 28px; font-weight: 300; margin-bottom: 12px; }
  .search-no-results-msg p { font-size: 14px; color: var(--mid-grey); margin-bottom: 28px; }
  .search-no-results-msg a { display: inline-block; padding: 14px 40px; background: var(--charcoal); color: var(--white); font-size: 11px; letter-spacing: 2px; text-transform: uppercase; }

  @media (max-width: 768px) {
    .search-page { padding: 32px 16px 60px; }
    .search-grid { grid-template-columns: repeat(2, 1fr); }
    .search-form input { padding: 12px 14px; }
    .search-form button { padding: 12px 16px; }
  }
</style>

<div class="search-page">
  <div class="search-page-header">
    <span class="eyebrow">Search</span>
    {%- if search.performed -%}
      <h1>Results for "{{ search.terms | escape }}"</h1>
      <p>{{ search.results_count }} product{% if search.results_count != 1 %}s{% endif %} found</p>
    {%- else -%}
      <h1>Search</h1>
    {%- endif -%}
  </div>

  <form action="/search" method="get" class="search-form">
    <input type="hidden" name="type" value="product" />
    <input type="text" name="q" value="{{ search.terms | escape }}" placeholder="Search jewellery…" autocomplete="off" />
    <button type="submit">Search</button>
  </form>

  {%- if search.performed -%}
    {%- if search.results_count > 0 -%}
      <p class="search-count">{{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %}</p>
      <div class="search-grid">
        {%- for product in search.results -%}
          <a href="{{ product.url }}" class="search-card">
            <div class="search-card-img">
              {%- if product.featured_image -%}
                <img src="{{ product.featured_image | img_url: '600x600', crop: 'center' }}" alt="{{ product.featured_image.alt | escape }}" loading="lazy" />
              {%- else -%}
                <div style="width:100%;height:100%;background:var(--blush);"></div>
              {%- endif -%}
            </div>
            <div class="search-card-info">
              <p class="search-card-name">{{ product.title }}</p>
              <p class="search-card-price">{{ product.price | money }}</p>
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="search-no-results-msg">
        <h2>No results found</h2>
        <p>Try a different search term, or browse all our jewellery below.</p>
        <a href="/collections/all">Shop All Jewellery</a>
      </div>
    {%- endif -%}
  {%- endif -%}
</div>
